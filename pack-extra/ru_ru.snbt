	quest.76E94639E90FEB4E.quest_desc: [
		"Размести несколько пустых &eулучшенных ульев&r в неосвещённой области. Пчёлы заселятся туда со временем."
	]
	quest.76E94639E90FEB4E.quest_subtitle: "Появляются в пустых ульях в темноте"
