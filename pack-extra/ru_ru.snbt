	quest.19341B01E048ACAB.quest_subtitle: "&6Открывает: Flux Networks (гл. 4), 6. Applied Energistics 2, 7. Extended и Advanced AE, 8. Ender IO, 9. Industrial Foregoing"
	quest.7C687DCF71D77761.quest_subtitle: "&6Открывает: 11. Extreme Reactors"
	quest.0F16498769DFB3B0.quest_subtitle: "&6Открывает: 3. Immersive Engineering"
	quest.1712C3B3CF158843.quest_subtitle: "&6Открывает: 5. Mekanism"
	quest.5621D5D63A456CC0.quest_subtitle: "&6Открывает: 5. Mekanism"
	quest.1AEFF93A398B8BBF.quest_subtitle: "&6Открывает: 12. Draconic Evolution"
	quest.15564C11744D6AA0.quest_subtitle: "&6Открывает: 12. Draconic Evolution"
	quest.7D38BC3DB3406F51.quest_subtitle: "&6Открывает: 2. Create"
	quest.051E0C85E7B71CE0.quest_subtitle: "&6Открывает: 4. Базовая энергия"
	chapter_group.5EEB207D06671AD1.title: "Create и дополнения"
	quest.11DC60F4392456DE.title: "&b&lФизические конструкции"
	quest.11DC60F4392456DE.quest_desc: [
		"&bCreate Aeronautics&r добавляет &eфизические конструкции&r: они летают, плавают, ездят и падают по-настоящему."
		""
		"&6Физический сборщик&r собирает блоки в такую конструкцию: выделите их &eсуперклеем&r или &eмёдоклеем&r, затем зажмите ПКМ и потяните рычаг сборщика."
		""
		"Собранной конструкцией можно пользоваться как обычными блоками. Отколовшиеся части становятся отдельными конструкциями, а &aслизь&r соединяет две конструкции в одну."
		""
		"Наведите на предмет в JEI и зажмите &eW&r — откроется анимированная подсказка &bPonder&r."
	]
	quest.5ECE3359AD3C2D6D.quest_desc: [
		"&6Мёдоклей&r — удобная замена суперклею для физических конструкций."
		""
		"Кликните по двум углам — получится склеенная область. &eCtrl + колесо мыши&r увеличивает или уменьшает её."
		"Для сложных конструкций он надёжнее: суперклей иногда цепляет лишние блоки."
	]
	quest.45CE921AE465E150.quest_desc: [
		"&6Оболочка аэростата&r — стенки воздушного шара."
		""
		"Оболочки окружают объём, который даёт &aподъёмную силу&r, когда его заполняет горячий воздух. Шар наполняется сверху вниз, поэтому он должен быть &eгерметичным&r."
		"Валы можно обернуть оболочкой, чтобы они не пропускали воздух. Блоки внутри шара уменьшают полезный объём."
		""
		"Оболочку можно перекрасить, кликнув по ней красителем."
	]
	quest.4B95423416419F82.quest_desc: [
		"&6Горелка аэростата&r наполняет шар над собой горячим воздухом, когда получает сигнал &cредстоуна&r."
		""
		"На панели выставляется максимальная мощность, а сила сигнала плавно её регулирует. Несколько горелок могут работать на один шар."
		"Подъёмная сила ограничена объёмом шара и слабеет с высотой: конструкция зависнет там, где подъёмная сила равна весу."
	]
	quest.1DC7D50C37F8A88B.quest_desc: [
		"&6Паровой клапан&r наполняет шар паром вместо горячего воздуха."
		""
		"Как и паровому двигателю Create, ему нужны &cтепло&r, &9вода&r и достаточный объём котла. Мощность регулируется так же, как у горелки."
	]
	quest.4D0EF322815EF6D1.quest_desc: [
		"&6Датчик высоты&r выдаёт сигнал редстоуна, который зависит от высоты. Минимум и максимум настраиваются в интерфейсе."
		""
		"Подключите его к горелке — и дирижабль сам будет держать нужную высоту."
	]
	quest.47D6E0D306CB0FB3.quest_desc: [
		"&dЛевититовая смесь&r — жидкость, из которой выращивают кристаллы левитита. Рецепт смотрите в JEI."
		""
		"Для кристаллизации нужно &cтепло&r: подожгите смесь или поставьте рядом источник тепла. Кристалл разрастётся по всей жидкости, и обратно собрать её уже нельзя."
		"Некоторые блоки в форме для отливки разрушаются при кристаллизации."
	]
	quest.5BA687D832E70629.quest_desc: [
		"&dЛевитит&r удерживает конструкцию в воздухе, если его достаточно."
		""
		"Подняться выше с одним левититом нельзя — нужны пропеллеры или двигатели. На малой скорости левитит сильно тормозит движение, на большой — почти не мешает."
	]
	quest.59C50446A65ED389.quest_desc: [
		"&6Пропеллерный подшипник&r крепится к блоку перед собой и создаёт &aтягу&r при вращении."
		""
		"Пропеллером может быть любая конструкция хотя бы с двумя парусами; чем больше парусов, тем больше тяга."
		"Смена направления вращения или клик ключом разворачивает тягу. Тягу и поток воздуха показывают &eинженерные очки&r."
	]
	quest.35B2D3528B8148F6.quest_desc: [
		"Готовый &6пропеллер&r ставится прямо на подшипник. Есть деревянный и андезитовый варианты."
	]
	quest.397FAE95386ECBE0.quest_desc: [
		"&6Гироскопический подшипник&r старается держать пропеллер вертикально — то, что нужно для &eвертолёта&r."
		""
		"Направленный вниз, он стабилизирует перевешивающую конструкцию. Сигнал редстоуна сбрасывает наклон."
	]
	quest.239BC0C896DA1DAC.quest_desc: [
		"&6Умный пропеллер&r создаёт тягу и сам наклоняется по одной оси, стараясь смотреть вверх."
	]
	quest.6F453BA5CF36D58B.quest_desc: [
		"&6Портативный двигатель&r сжигает топливо и выдаёт вращение — источник энергии прямо на борту."
		""
		"Направление вращения настраивается, а топливо можно подавать автоматически."
	]
	quest.6120998501A9E71F.quest_desc: [
		"&6Штурвал&r — управление вашей конструкцией. Наведите на предмет в JEI и зажмите &eW&r — откроется анимированная подсказка &bPonder&r."
	]
	quest.146FB762CE4A2BBD.quest_desc: [
		"&6Навигационный стол&r выдаёт сигнал редстоуна в сторону цели, если положить в него навигационный предмет. На нём можно построить автопилот."
	]
	quest.36183A88B2B9437A.quest_desc: [
		"&6Колёсное крепление&r держит колесо и позволяет конструкции ездить по земле."
	]
	quest.239149C4571AA876.quest_desc: [
		"&6Шины&r бывают маленькими, обычными, большими и огромными. Четыре колеса — и машина готова!"
	]
	quest.1B8F66BD27CD8130.quest_desc: [
		"&6Буровой подшипник&r вместе с &6бурильными колёсами&r и хранилищем превращается в &eбуровую машину&r."
		""
		"Чем больше блоков нужно сломать, тем медленнее он работает; несколько подшипников это компенсируют."
	]
	quest.61BA2CF7F50BEA63.quest_desc: [
		"&6Бурильное колесо&r ломает блоки вокруг себя и цепляется к соседним колёсам без суперклея."
	]
	quest.30A1753E17BE3111.quest_desc: [
		"&bCreate Propulsion&r: &6двигатель&r даёт направленную тягу при сигнале редстоуна. Топливо — &eскипидар&r (рецепт в JEI)."
	]
	quest.2DF3094718C26797.quest_desc: [
		"&6Ионный двигатель&r работает на энергии &aFE&r вместо топлива."
	]
	quest.2C06BDB8D8F56413.quest_desc: [
		"&6Векторный двигатель&r может поворачивать сопло по рысканию и тангажу — для точного маневрирования."
	]
	quest.21DBD1D39A8DCA03.quest_desc: [
		"&6Редстоуновый двигатель&r: тяга зависит от силы сигнала и скорости вращения."
		""
		"Дальше — &6латунный&r (большой, 3×3×3, с поворотом тяги) и &6огненный&r (на топливе, не тратит нагрузку)."
	]
	quest.3ACE6F33BACFB3D0.quest_desc: [
		"&6Огненный двигатель&r работает на топливе и не потребляет кинетическую нагрузку."
	]
	quest.760DC650F91E1D4C.quest_desc: [
		"&6Реактивный ранец&r носится на груди и работает на &eсжатом воздухе&r, как медный баллон Create. Заправляйте его так же, как баллон."
		""
		"Позже его можно улучшить до незеритового."
	]
	chapter.1F589DC846685257.title: "&bCreate: Аэронавтика"
	chapter.1F589DC846685257.chapter_subtitle: [
		"Дирижабли, вертолёты, машины и реактивные ранцы"
	]
	quest.13904DEF1C11F735.quest_desc: [
		"&bCreate Crafts & Additions&r связывает Create с электричеством."
		""
		"&6Генератор переменного тока&r превращает вращение в энергию &aFE&r, которую понимают Mekanism, AE2 и другие моды."
	]
	quest.147A4A40A0A04DC4.quest_desc: [
		"&6Электромотор&r делает обратное: тратит &aFE&r и выдаёт вращение. Скорость настраивается."
	]
	quest.571A022ACAC5B68C.quest_desc: [
		"&6Аккумулятор&r хранит энергию. Ставьте блоки рядом — они объединяются в одно большое хранилище."
	]
	quest.4C57219A6C12ACE8.quest_desc: [
		"&6Прокатный стан&r делает из слитков и листов &eстержни&r и &eпровода&r."
	]
	quest.31400E2210435A10.title: "&6Провода и соединители"
	quest.31400E2210435A10.quest_desc: [
		"Энергию можно передавать по проводам: поставьте &6соединители&r на машины и кликните между ними &6катушкой&r."
		""
		"Для длинных линий и больших мощностей есть высоковольтные соединители и электрумовые провода."
	]
	quest.4C46126461B1CD22.quest_desc: [
		"&6Катушка Теслы&r заряжает энергией предметы на депо под собой."
	]
	quest.3BE90F01FF01CF99.quest_desc: [
		"&bCreate: Enchantment Industry&r — опыт как жидкость."
		""
		"&6Осушитель точила&r снимает зачарования с предметов и превращает их в &aжидкий опыт&r."
	]
	quest.202E5676877409A9.quest_desc: [
		"&6Всполох-чародей&r зачаровывает предметы жидким опытом. Какое зачарование наложить, задаёт &eшаблон зачарования&r."
	]
	quest.46D01B2DF89897B9.quest_desc: [
		"&6Принтер&r копирует книги — в том числе зачарованные — за жидкий опыт."
	]
	quest.78A19317DC5C0EED.quest_desc: [
		"&bCreate Big Cannons&r — настоящая артиллерия."
		""
		"На &6крепление пушки&r ставится собранная пушка: казённая часть, стволы и дуло. Наводка делается вращением."
	]
	quest.571386D302F06B90.quest_desc: [
		"Части пушки отливают из жидкого металла в формах, а потом рассверливают &6пушечной дрелью&r. Начните с &7чугуна&r."
	]
	quest.7140BF7EAE849217.title: "&6Снаряды и порох"
	quest.7140BF7EAE849217.quest_desc: [
		"Для выстрела нужны &6снаряд&r и &6пороховой заряд&r. Зарядите их толкателем или пушечным заряжателем и подайте сигнал редстоуна."
	]
	quest.601CC3888976E334.quest_desc: [
		"&bCreate Ore Excavation&r: под землёй есть бесконечные &eрудные жилы&r. &6Детектор рудных жил&r показывает, какая жила под вами."
	]
	quest.62617171444EA7C8.quest_desc: [
		"&6Буровая установка&r с буром добывает руду из жилы, пока есть вращение — жилы очень большие. Для жидких жил есть насосная установка."
	]
	quest.2B8ADEB7A4161293.quest_desc: [
		"&bCreate: Connected&r добавляет много полезных деталей."
		""
		"&6Кинетический накопитель&r запасает вращение и отдаёт его позже. Ещё в моде есть тормоз, предохраняющее сцепление, шестисторонняя передача и силос предметов."
	]
	quest.259169841C8EAEE9.quest_desc: [
		"&6Вентиляторные катализаторы&r заменяют лаву, костёр или воду перед вентилятором — массовая обработка становится компактной."
	]
	quest.143E83656F4CC69A.quest_desc: [
		"&bCopycats+&r: &6заполняемые блоки&r принимают вид любого блока — кликните по ним нужным блоком. Склоны, ступеньки, панели, двери и многое другое."
	]
	quest.5C6D8339F42D47CC.quest_desc: [
		"&bCreate Deco&r — мостики, перила, решётки, светильники и листовой металл в стиле Create."
	]
	quest.5C1E7F05E037E5ED.title: "&bГипертрубы"
	quest.5C1E7F05E037E5ED.quest_desc: [
		"&bCreate Hypertube&r: прокладывайте &6гипертрубы&r и путешествуйте по ним на большой скорости через &6вход&r."
	]
	quest.7C66D445436D76E2.quest_desc: [
		"&bSlice & Dice&r: &6ломтерезка&r автоматизирует рецепты разделочной доски Farmer's Delight, а &6ороситель&r поливает грядки."
	]
	chapter.6E389ECB0C0FD195.title: "&6Create: дополнения"
	chapter.6E389ECB0C0FD195.chapter_subtitle: [
		"Электричество, опыт, пушки, бурение и удобства"
	]
	quest.41CFDE281223B513.quest_desc: [
		"&bFarmer's Delight&r делает еду полноценной частью игры."
		""
		"&6Нож&r — главный кухонный инструмент: им режут продукты на &6разделочной доске&r, а ещё он даёт больше мяса с животных."
	]
	quest.23A5249D3CEDDF2D.quest_desc: [
		"Положите продукт на &6разделочную доску&r и кликните по нему ножом, топором или киркой — получите нарезку, доски или другие детали."
	]
	quest.3E220FF3AB4220A7.quest_desc: [
		"&6Кухонный котёл&r готовит супы, рагу и сложные блюда. Поставьте его над огнём или плитой. Готовое блюдо разливают по мискам."
	]
	quest.45059E1936D8393A.quest_desc: [
		"&6Плита&r — удобный источник тепла для котла и сковороды. На ней можно жарить сразу несколько продуктов."
	]
	quest.5C96D11521DF306F.quest_desc: [
		"&6Сковорода&r жарит продукты на огне — а ещё это неплохое оружие."
	]
	quest.70F1EDB1EF7DDC76.title: "&aНовые культуры"
	quest.70F1EDB1EF7DDC76.quest_desc: [
		"Новые культуры растут в мире дикими: &cтоматы&r, &aкапуста&r, &eлук&r и &fрис&r. Соберите их и посадите у себя."
		""
		"Рис сажают в воду."
	]
	quest.49C14DA1922FE15A.quest_desc: [
		"&6Органический компост&r со временем превращается в &6плодородную почву&r: на ней растения растут быстрее, а грибы — колониями."
	]
	quest.1F1A88947900F7F9.quest_desc: [
		"Большие блюда ставятся на стол как блок и делятся на несколько порций — кликните по ним миской."
	]
	quest.3C8A6090C8DCD19F.quest_desc: [
		"&bLet's Do Vinery&r — виноделие."
		""
		"Найдите &5виноград&r (у разных биомов свои сорта), выжмите сок в &6яблочном прессе&r или &6виноградной ванне&r, затем выдержите его в &6бродильной бочке&r."
	]
	quest.341A8A79CEB81F9D.quest_desc: [
		"Вино даёт полезные эффекты, а со временем становится крепче. Храните бутылки на полках и в винных ящиках."
	]
	quest.54598BFD18D0752B.quest_desc: [
		"&bLet's Do Herbal Brews&r — чай и кофе."
		""
		"Соберите чайные листья, высушите их и заварите в &6чайнике&r на плите. Напитки дают приятные эффекты."
	]
	quest.2D599F6F6E595ED3.quest_desc: [
		"&bOcean's Delight&r добавляет блюда из морских существ: стражей, кальмаров, иглобрюхов и ламинарии."
	]
	quest.349EFFDE6C6FA611.quest_desc: [
		"&bEnder's Delight&r — кухня Энда: хорус, шалкеры и эндермиты. Где добыть ингредиенты — смотрите в JEI."
	]
	quest.6E9233D6778EEDB3.quest_desc: [
		"&bMore Delight&r и &bExpanded Delight&r добавляют ещё десятки блюд: тосты, бургеры, пасту, сыр и многое другое."
	]
	chapter.2A4B7B1EDC1110C1.title: "&eКухня и напитки"
	chapter.2A4B7B1EDC1110C1.chapter_subtitle: [
		"Farmer's Delight, вино, чай и экзотические блюда"
	]
	quest.5E2CA2C2944528C0.quest_desc: [
		"&6Путеводные обелиски&r встречаются в деревнях и по всему миру. Кликните по обелиску, чтобы запомнить его."
		""
		"Затем от любого обелиска можно телепортироваться к запомненным — за небольшую плату опытом."
	]
	quest.282433DDBF7B539B.quest_desc: [
		"&6Камень перемещения&r открывает меню обелисков откуда угодно. После использования ему нужно время на перезарядку."
	]
	quest.3D0767F5958CA9BA.quest_desc: [
		"&6Свиток возврата&r — одноразовый телепорт к последнему обелиску. Есть и другие свитки с другими целями."
	]
	quest.75AE7A3380BACD64.quest_desc: [
		"&6Природный компас&r ищет нужный &eбиом&r: выберите его в списке, и стрелка покажет направление."
	]
	quest.43FBF0FDDA4BD9CA.quest_desc: [
		"&6Пояс для инструментов&r носится в слоте аксессуаров и хранит несколько инструментов — переключайтесь между ними без инвентаря. Улучшается до незеритового."
	]
	quest.41008631F5F59B22.quest_desc: [
		"&6Спальный мешок&r позволяет переночевать в походе и не сбивает точку возрождения. &6Гамак&r — поспать днём."
	]
	quest.6CF8CAE814822F53.title: "&bФотоаппарат"
	quest.6CF8CAE814822F53.quest_desc: [
		"&bExposure&r: настоящий &6фотоаппарат&r. Вставьте плёнку, сделайте снимки, проявите плёнку и напечатайте фото в &6фотолаборатории&r (рецепты в JEI)."
	]
	quest.6E501776ACDABACC.quest_desc: [
		"&6Ботанический горшок&r выращивает растение и деревья без участка земли. Вариант с воронкой сам выгружает урожай."
	]
	quest.33AEEAD73C365296.quest_desc: [
		"&bBaubley Heart Canisters&r: из сердец, выпадающих из монстров, делают &6контейнеры&r, которые навсегда добавляют здоровье. Вставляются в амулет сердец."
	]
	quest.788638C51EB0E38A.quest_desc: [
		"&6Том Акаши&r объединяет все справочники модов в одну книгу. Положите их в него крафтом."
	]
	chapter.1BDD9F764BF50B52.title: "&aПутешествия и удобства"
	chapter.1BDD9F764BF50B52.chapter_subtitle: [
		"Телепорты, компасы, ночлег и полезные мелочи"
	]
	quest.39F4F4275D481589.title: "&b&lШахтёрский лазер"
	quest.39F4F4275D481589.quest_desc: [
		"&bMining Gadgets&r — лазерный бур, который работает на энергии &aFE&r."
		""
		"Зажмите ПКМ, чтобы добывать блоки лучом. Заряжайте гаджет в любом зарядном устройстве: Mekanism, Flux Networks, Ender IO и других."
		""
		"Есть три варианта корпуса: простой, обычный и навороченный. Подойдёт любой."
	]
	quest.246263D4A663F966.quest_desc: [
		"&6Стол модификаций&r вставляет улучшения в гаджет и вынимает их обратно."
	]
	quest.10936769B88197ED.quest_desc: [
		"&6Чистый модуль улучшения&r — заготовка для всех улучшений. Из него крафтятся остальные модули."
	]
	quest.614A14EB70B180A4.quest_desc: [
		"Улучшение &e3×3&r — гаджет добывает сразу квадрат блоков."
	]
	quest.61610D34F006DCC1.title: "&aУдача или шёлк"
	quest.61610D34F006DCC1.quest_desc: [
		"&aУдача&r даёт больше руды, &aшёлковое касание&r добывает блоки целиком. Вместе их поставить нельзя — выберите одно."
	]
	quest.706466213CA149BD.quest_desc: [
		"&6Магнит&r сразу забирает добытое в инвентарь."
	]
	quest.31A3558E59D237B2.quest_desc: [
		"&6Пустотная мусорка&r уничтожает ненужные блоки вроде булыжника — список настраивается."
	]
	quest.638FF0297CA93045.quest_desc: [
		"&6Установка света&r сама ставит шахтёрский свет в тёмных местах."
	]
	quest.6985CCFD3EB640B8.quest_desc: [
		"&6Батарея&r увеличивает запас энергии. Уровни 2 и 3 — ещё больше."
	]
	chapter.11D38CB881BC1703.title: "&bШахтёрские гаджеты"
	chapter.11D38CB881BC1703.chapter_subtitle: [
		"Лазерный бур и его улучшения"
	]
	quest.706D8CBCEF3B0F1F.title: "&6Сундуки с добычей"
	quest.706D8CBCEF3B0F1F.quest_desc: [
		"&bLootr&r: сундуки, бочки и вазы в данжах и деревнях стали &eличными&r — каждый игрок получает из них свою добычу."
		""
		"Такие сундуки подсвечены особой текстурой. Можно спокойно исследовать мир вместе с друзьями — никто не заберёт ваш лут."
		""
		"Нажмите галочку, чтобы выполнить квест."
	]
	quest.4D4F3FB2ABC703CC.title: "&6Справочник инженера"
	quest.4D4F3FB2ABC703CC.quest_subtitle: "Книга по Create и всем дополнениям"
	quest.4D4F3FB2ABC703CC.quest_desc: [
		"Нажмите галочку и заберите награду — &6Справочник инженера&r."
		""
		"В книге по шагам описаны &eCreate&r и все его дополнения в сборке: вращение, обработка, логистика, механизмы, поезда, Аэронавтика, электричество, пушки и прочее."
		""
		"Потеряли книгу? Скрафтите новую из &fкниги&r и &7андезитового сплава&r."
	]
	quest.6091765DCA3A9B66.title: "&6Create: Protection Pixel"
	quest.6091765DCA3A9B66.quest_desc: [
		"&bProtection Pixel&r добавляет тяжёлую &6силовую броню&r в стиле Create: шлемы, нагрудники и поножи с особыми эффектами, бронеплиты, крылья и снаряжение."
		""
		"Почти всё собирается на &eмеханическом крафтере&r Create. Начните с &6армированного волокна&r."
	]
	quest.6E1C85BD4CCA4865.quest_desc: [
		"&6Защитные носки&r нужны, чтобы ноги выдерживали тяжёлую силовую броню. Без них в такой броне тяжело."
	]
	quest.4BE579E149C33583.quest_desc: [
		"&6Подкладка нагрудника&r — одна из деталей для сборки силовой брони. Рецепты смотрите в JEI."
	]
	quest.13691D096732F7A0.quest_desc: [
		"&6Бронеплиты&r навешиваются на силовую броню и дают защиту. Железные делаются на механическом крафтере."
		""
		"Наведите на броню и зажмите &eShift&r, чтобы посмотреть систему плит. Каждая плита добавляет вес."
	]
	quest.6FD57117BE366119.quest_desc: [
		"&6Латунные бронеплиты&r прочнее железных. Чинятся латунным слитком на наковальне."
	]
	quest.64205A40836E5D23.quest_desc: [
		"&6Сплавные бронеплиты&r — лучшие. Делаются &eпоследовательной сборкой&r и чинятся незеритовым ломом."
	]
	quest.120C60468A8695E7.quest_desc: [
		"&6Платформа загрузки брони&r ставит и снимает бронеплиты с брони."
		""
		"Ей нужна &cлава&r по трубам: каждая установка или снятие плиты тратит 100 мБ, сама платформа хранит 200 мБ. Также подайте вращение на шестерню снизу."
	]
	quest.7D9E7695543A3A88.quest_desc: [
		"&6Реактор сгорания&r вставляется в слот питания и питает всю силовую броню. Без питания её функции не работают."
	]
	quest.240B4D626CFB4864.quest_desc: [
		"&6Паровой усилитель&r позволяет нести на 3 единицы веса больше. Перегруз замедляет."
	]
	quest.5DD94E6ADFAA9514.quest_desc: [
		"&6Чумной шлем&r каждые 10 секунд снимает слепоту, слабость, замедление и тьму, а ещё лучше видно в тумане."
		""
		"У каждой брони есть улучшенная версия с пометкой &eAS&r — эффекты у неё сильнее."
	]
	quest.4D3D5AF4671DE27B.quest_desc: [
		"&6Нагрудник «Разрушитель»&r добавляет 3 урона к каждой атаке. Есть и другие нагрудники: с крыльями, дронами, щитом и магнитом."
	]
	quest.30CFC4DB5901B698.quest_desc: [
		"&6Поножи «Рогатка»&r ускоряют бег на 10% и повышают прыжок. Другие поножи защищают от падения или позволяют ходить по жидкости."
	]
	quest.68B4618DD34CC9CA.quest_desc: [
		"&6Подвесной ранец&r удерживает в воздухе. Нужен медный баллон Create. Включается: присесть и нажать пробел."
	]
	quest.57BDC1C88F96D0F1.quest_desc: [
		"&6Маневровое крыло&r даёт полёт и разгоняет вас в планировании. Нужно место для разгона."
	]
	quest.48D5C0DFF96E121D.quest_desc: [
		"&6Крюк-пушка&r: присядьте и нажмите пробел, чтобы выстрелить крюком — быстро забраться наверх или притянуть добычу."
	]
	quest.66F3F8DE1EDD7569.quest_desc: [
		"&6Вешалка для брони&r красиво выставляет нагрудник, поножи и ботинки."
	]
	chapter.3AA17358C16C1C33.title: "&6Create: Protection Pixel"
	chapter.3AA17358C16C1C33.chapter_subtitle: [
		"Силовая броня в стиле Create"
	]
	quest.4D0435819989021C.quest_desc: [
		"&6Люк опыта&r — самый простой способ залить свой опыт в жидкость: ПКМ — сдать опыт, Shift+ПКМ — забрать обратно."
		""
		"Опыт также дают мобы, убитые дробильными колёсами или развёртывателем."
	]
	quest.682455F3AD51180C.quest_desc: [
		"&6Фонарь опыта&r сам собирает опыт с игроков и шаров опыта рядом. Работает и на движущихся механизмах."
	]
	quest.7FAAA782066790E5.quest_desc: [
		"&6Шаблон зачарования&r записывает зачарования. Положите в фильтр всполоха-чародея предмет-образец — и он будет зачаровывать шаблоны только подходящими для этого предмета чарами."
	]
	quest.44BDB4C1268F82B1.quest_desc: [
		"&6Всполох-кузнец&r работает как наковальня, но без растущей цены ремонта. Он переносит шаблоны на предметы, объединяет зачарования и снимает их обратно в шаблон."
	]
	quest.5223A2B4E163EBC7.title: "&5Супер-зачарование"
	quest.5223A2B4E163EBC7.quest_desc: [
		"Покормите всполоха-чародея или кузнеца &5тортом зачарования&r — он перейдёт в режим &5супер-зачарования&r."
		""
		"Так можно превысить обычный предел уровней, объединить несовместимые чары и получить сокровищные зачарования."
		""
		"&cВажно:&r это вызывает удары молнии — поставьте рядом громоотвод."
	]
	chapter.7AF827D2D101D343.title: "&dАртефакты"
	quest.010607466D565B53.quest_desc: [
		"Почувствуйте связь с матушкой-природой. \\n\\nС &aкорнеходцами&r природа становится вашим лучшим другом! Когда вы стоите на траве, ваши сердца будут восстанавливаться. Также, если вы едите пищу, стоя на траве, это действует как костная мука."
	]
	quest.010607466D565B53.quest_subtitle: "Ноги"
	quest.010607466D565B53.title: "&aКорнеходцы&r"
	quest.0A1D4228271DECA3.quest_desc: [
		"Куда ты пропал? \\n\\nО, ты просто уменьшился вдвое. Достаточно, чтобы пролезть под блоком."
	]
	quest.0A1D4228271DECA3.quest_subtitle: "Ожерелье"
	quest.0A1D4228271DECA3.title: "&5Амулет уменьшения&r"
	quest.0E716B90E60C486B.quest_desc: [
		"Иногда лучший способ сражаться — это не сражаться, а убежать! \\n\\nС &4паническим ожерельем&r, при получении урона вы получите эффект скорости на короткое время. Как раз достаточно, чтобы сбежать!"
	]
	quest.0E716B90E60C486B.quest_subtitle: "Ожерелье"
	quest.0E716B90E60C486B.title: "&4Паническое ожерелье&r"
	quest.11C5F17C6BB1237B.quest_desc: [
		"При ношении &5иссохшего браслета&r ближние атаки имеют шанс наложить эффект иссушения. \\n\\nСожалеем, лучники!"
	]
	quest.11C5F17C6BB1237B.quest_subtitle: "Запястья (руки)"
	quest.11C5F17C6BB1237B.title: "&5Иссохший браслет&r"
	quest.122E6E7CABCB17E7.quest_desc: [
		"По какой-то причине криперы боятся кошек. Криперы также крайне глупы и думают, что кошки, на которые похожи ваши &7тапки&r, настоящие. \\n\\nВсе криперы будут убегать от вас и не будут агрессивными, если на вас надеты эти &7тапки&r. \\n\\nТакже они издают звуки кошек, когда вы получаете урон! (Но не гарантирую, что вы всегда будете приземляться на ноги)."
	]
	quest.122E6E7CABCB17E7.quest_subtitle: "Ноги"
	quest.122E6E7CABCB17E7.title: "&7Тапки-котятки&r"
	quest.145E7D1A88B83DDD.quest_desc: [
		"Куда ты пропал?"
	]
	quest.145E7D1A88B83DDD.quest_subtitle: "Шарф (ожерелье)"
	quest.145E7D1A88B83DDD.title: "&9Шарф невидимости&r"
	quest.161A90E134592D0E.quest_desc: [
		"Как и обычное сырое мясо, &cвечную говядину&r можно приготовить, чтобы получить &4вечный стейк&r! \\n\\nРаботает так же, как &cвечная говядина&r, но с большим количеством очков сытости."
	]
	quest.161A90E134592D0E.quest_subtitle: "Уникальный"
	quest.161A90E134592D0E.title: "&4Вечный стейк&r"
	quest.16255FB20F35A9D9.quest_desc: [
		"&3Дыхательная трубка&r даёт вам небольшое дыхание под водой при погружении. Похоже на черепаший шлем! Но будьте осторожны — эффект временный."
	]
	quest.16255FB20F35A9D9.quest_subtitle: "Голова"
	quest.16255FB20F35A9D9.title: "&3Дыхательная трубка"
	quest.19B393433FB0C62F.quest_desc: [
		"Секрет лавомерок, позволяющий им ходить по &cлаве&r, кроется в их ногах. Поэтому мы сняли их ноги и дали вам! \\n\\nКогда вы крадётесь, вы можете безопасно ходить по &cлаве&r! Если вы перестанете красться, вы упадёте в &cлаву&r. Эти ботинки также позволяют безопасно ходить по блокам магмы и другим горячим блокам!"
	]
	quest.19B393433FB0C62F.quest_subtitle: "Ноги"
	quest.19B393433FB0C62F.title: "&4Балетки-лавомерки&r"
	quest.1E40ACF3E69A4100.quest_desc: [
		"Нужно ли его пить? Не знаю, оно просто работает... \\n\\nС &6сосудом с противоядием&r длительность негативных эффектов (например, иссушение или яд) сокращается! Очень полезно при встрече с ведьмами или иссушителями."
	]
	quest.1E40ACF3E69A4100.quest_subtitle: "Пояс"
	quest.1E40ACF3E69A4100.title: "&6Сосуд с противоядием&r"
	quest.2215FB0777D7029D.quest_desc: [
		"Шипы, кошки, ледоступы — как бы их ни называли! \\n\\n&7Стойкие шипы&r помогают вам устоять на ногах. Вы не будете отбрасываться при атаках и больше не будете скользить по льду."
	]
	quest.2215FB0777D7029D.quest_subtitle: "Ноги"
	quest.2215FB0777D7029D.title: "&7Стойкие шипы&r"
	quest.221C9EDA651144BA.quest_desc: [
		"Какая &9вода&r? \\n\\nС &3амулетом погружения&r вы перемещаетесь в &9воде&r, как в воздухе! Но дышать под водой всё ещё нельзя..."
	]
	quest.221C9EDA651144BA.quest_subtitle: "Ожерелье"
	quest.221C9EDA651144BA.title: "&3Амулет погружения&r"
	quest.2607F3DC07049785.quest_desc: [
		"Зачем тратить время на неторопливую трапезу, если можно есть и пить на ходу? \\n\\nС этим стильным &6шлемом&r процесс станет намного быстрее!"
	]
	quest.2607F3DC07049785.quest_subtitle: "Голова"
	quest.2607F3DC07049785.title: "&6Пластиковый шлем для питья"
	quest.27E951F4F4F6F847.quest_desc: [
		"Похож на &aколючий кулон&r, только гораздо горячее. Нет, подождите, намного горячее! \\n\\n&cПламенный кулон&r может поджечь ваших атакующих! Когда они горят, &cкулон&r также даёт вам сопротивление огню."
	]
	quest.27E951F4F4F6F847.quest_subtitle: "Ожерелье"
	quest.27E951F4F4F6F847.title: "&cПламенный кулон&r"
	quest.29448D08C8777425.quest_desc: [
		"«К утру он будет спать с рыбами». \\n\\n&cШляпа рыболова&r помогает приманивать рыбу и увеличивает шансы на редкую добычу!"
	]
	quest.29448D08C8777425.quest_subtitle: "Голова"
	quest.29448D08C8777425.title: "&cШляпа рыболова"
	quest.2AD78E22988A92D3.quest_desc: [
		"Я вижу тебя! \\n\\nВ &2очках ночного видения&r вы получаете способность видеть в темноте! Больше ничего особенного..."
	]
	quest.2AD78E22988A92D3.quest_subtitle: "Голова"
	quest.2AD78E22988A92D3.title: "&2Очки ночного видения"
	quest.321F16645640C462.quest_desc: [
		"Эндер-жемчуг — это веселый способ путешествовать! (Очень полезно для Жужжилища, интересно, будет ли глава квестов для этого мода!) Но разве не раздражает, что эндер-жемчужина тратится при использовании и наносит 2 сердца урона каждый раз? \\n\\nС &9варп-двигателем&r всё это исчезает, делая эндер-жемчужины лучшим способом транспортировки! Вместо жемчужины тратится голод, и вы больше не получаете урон от использования эндер-жемчуга. Когда все полоски голода будут истощены, снова начнут тратиться эндер-жемчужины."
	]
	quest.321F16645640C462.quest_subtitle: "Пояс"
	quest.321F16645640C462.title: "&9Варп-двигатель&r"
	quest.3446803FB59D8875.quest_desc: [
		"Даёт вам шипы. Не вашей броне, а вам! Как у рыбы-фугу!"
	]
	quest.3446803FB59D8875.quest_subtitle: "Ожерелье"
	quest.3446803FB59D8875.title: "&aКолючий кулон&r"
	quest.3525D5DCC3A534D9.quest_desc: [
		"Это один из моих любимых артефактов! \\n\\n&9Землеройные когти&r: 1. Увеличивают скорость добычи, как уровень эффективности для всех кирок, и 2. Делают ваши кулаки эквивалентными каменной кирке! \\n\\nОчень полезно для строительства и просто игры в целом!"
	]
	quest.3525D5DCC3A534D9.quest_subtitle: "Руки"
	quest.3525D5DCC3A534D9.title: "&9Землеройные когти&r"
	quest.3705D303CF423804.quest_desc: [
		"Дополнение к &aзвериным когтям&r — эти перчатки увеличивают урон, который вы наносите, пока носите их."
	]
	quest.3705D303CF423804.quest_subtitle: "Руки"
	quest.3705D303CF423804.title: "&eСиловая перчатка&r"
	quest.3B3BD39BA02DCA13.quest_desc: [
		"С &6карманным поршнем&r ваши атаки будут отбрасывать врагов намного дальше! \\n\\nИнтересно, что победит: &6карманный поршень&r или &7стойкие шипы&r?"
	]
	quest.3B3BD39BA02DCA13.quest_subtitle: "Руки"
	quest.3B3BD39BA02DCA13.title: "&6Карманный поршень&r"
	quest.3E0643EA9183CDAE.quest_desc: [
		"«Это была его шляпа, мистер Крабс! Он был номером 1!» \\n\\nДелает то же самое, что и обычный &6шлем для питья&r, просто выглядит круче!"
	]
	quest.3E0643EA9183CDAE.quest_subtitle: "Голова"
	quest.3E0643EA9183CDAE.title: "&9Необычный шлем для питья"
	quest.3E1A3BC8642390B3.quest_desc: [
		"«Я Мэри Поппинс, ребята!» \\n\\n&4Зонт&r — это очень полезный инструмент, добавленный &l&3Artifacts&r! Его можно держать перед собой как щит, зажав ПКМ. Или использовать для замедления падения, просто держа его!"
	]
	quest.3E1A3BC8642390B3.quest_subtitle: "Уникальный"
	quest.3E1A3BC8642390B3.title: "&4Зонт&r"
	quest.3EC8A0B89788D079.quest_desc: [
		"У меня нет рук, у меня есть &9ласты&r. \\n\\n&9Ласты&r работают как улучшенная версия зачарования «Подводная ходьба». Вы сможете плавать и ходить по &9воде&r намного быстрее!"
	]
	quest.3EC8A0B89788D079.quest_subtitle: "Ноги"
	quest.3EC8A0B89788D079.title: "&9Ласты&r"
	quest.427014BDE06DE631.quest_desc: [
		"Всё, во что я попадаю, вспыхивает пламенем!!!!!"
	]
	quest.427014BDE06DE631.quest_subtitle: "Руки"
	quest.427014BDE06DE631.title: "&cОгненная перчатка&r"
	quest.436E4E3515BCCDE9.quest_desc: [
		"С &bоблаком в бутылке&r вы можете нажать пробел дважды, чтобы сделать двойной прыжок! Очень полезно для паркура! \\n\\nТакже увеличивает высоту, с которой вы можете упасть, как &dзайцы-прыгуны&r!"
	]
	quest.436E4E3515BCCDE9.quest_subtitle: "Пояс"
	quest.436E4E3515BCCDE9.title: "&bОблако в бутылке&r"
	quest.4564B577CB4EC046.quest_desc: [
		"Когда вы забиваете сотни коров, вы можете наткнуться на редкий кусок мяса. Не с коровьим бешенством, а &cвечную говядину&r! \\n\\n&cВечную говядину&r можно есть, как обычное сырое мясо, но она не исчезнет после употребления! Вместо этого у неё будет перезарядка перед следующим использованием. \\n\\n(Также работает с автоподачей из рюкзаков!)"
	]
	quest.4564B577CB4EC046.quest_subtitle: "Уникальный"
	quest.4564B577CB4EC046.title: "&cВечная говядина&r"
	quest.4933CF4675E77D50.quest_desc: [
		"После получения урона от огня &5обсидиановый череп&r активируется, давая вам временное сопротивление огню. Надеюсь, этого хватит, чтобы выбраться из пламени!"
	]
	quest.4933CF4675E77D50.quest_subtitle: "Пояс"
	quest.4933CF4675E77D50.title: "&5Обсидиановый череп&r"
	quest.4A7AEBEB87CEC274.quest_desc: [
		"Я не уверен, что могу использовать название конкретного бренда &cкроссовок&r, так что представьте, какие они. \\n\\n&cКроссовки&r дают вам ускорение при беге, так что вы сможете бегать ещё быстрее! Также они автоматически заставляют вас прыгать при беге..."
	]
	quest.4A7AEBEB87CEC274.quest_subtitle: "Ноги"
	quest.4A7AEBEB87CEC274.title: "&cКроссовки&r"
	quest.4D3379D38237F830.quest_desc: [
		"Когда вы носите &bэто&r на ногах, вы можете творить чудеса! Ходить по &9воде&r! \\n\\nНу, на самом деле бегать по &9воде&r — для этого нужно бежать. Как только вы перестанете бежать, начнёте тонуть."
	]
	quest.4D3379D38237F830.quest_subtitle: "Ноги"
	quest.4D3379D38237F830.title: "&bВодные бегуны&r"
	quest.5040B3D29F238BC0.quest_desc: [
		"Прыг-скок, прыг-скок, прыг-скок.\\n\\nС &dзайцами-прыгунами&r вы можете прыгать в два раза выше и получать вдвое меньше урона от падения! Это не делает вас неуязвимым к урону от падения — вы всё ещё можете умереть, но это сложнее."
	]
	quest.5040B3D29F238BC0.quest_subtitle: "Ноги"
	quest.5040B3D29F238BC0.title: "&dЗайцы-прыгуны&r"
	quest.50A32AC6EDBC5854.quest_desc: [
		"Еда сама по себе может быть скучной, но всё становится лучше, когда у вас есть гарнир к блюду! А именно — &6луковое кольцо&r! \\n\\nКогда вы носите &6луковое кольцо&r, всё, что вы едите, будет давать вам небольшое ускорение."
	]
	quest.50A32AC6EDBC5854.quest_subtitle: "Руки"
	quest.50A32AC6EDBC5854.title: "&6Луковое кольцо&r"
	quest.589F1D502F680075.quest_desc: [
		"Идеально для вечеринок у бассейна! \\n\\n&dГелиевый фламинго&r не только мило выглядит, но и даёт плавать прямо по воздуху. Да-да, именно плавать... по... воздуху! \\n\\nВо время прыжка нажмите CTRL, чтобы поплыть. Управление такое же, как в воде: можно двигаться вверх, вниз и в любую сторону!"
	]
	quest.589F1D502F680075.quest_subtitle: "Пояс"
	quest.589F1D502F680075.title: "&dГелиевый фламинго&r"
	quest.5CE44C58A470E48E.quest_desc: [
		"&l&3Artifacts&r — это замечательный мод, который добавляет &l&3артефакты&r, делающие ваш опыт в Майнкрафте проще и увлекательнее! \\n\\nВсе &l&3артефакты&r можно найти, исследуя мир, занимаясь археологией или убивая мимиков! \\n\\nМимики прячутся в подземных лагерях, выглядя как обычные сундуки! Но как только вы подойдёте слишком близко, они атакуют!"
	]
	quest.5CE44C58A470E48E.title: "&l&3Артефакты&r"
	quest.5DE7C4FD5FA29236.quest_desc: [
		"Разве не бесит, когда вы почти убиваете эндермена, а он телепортируется? На самом деле вы не злитесь, вы просто завидуете! Вы хотите так же! \\n\\nИ с &5поясом хоруса&r вы сможете это сделать! Вы будете телепортироваться при ударе, который мог бы вас убить."
	]
	quest.5DE7C4FD5FA29236.quest_subtitle: "Пояс"
	quest.5DE7C4FD5FA29236.title: "&5Пояс хоруса&r"
	quest.5EB7CE3A1DCD3E9B.quest_desc: [
		"Это &cмагнит&r."
	]
	quest.5EB7CE3A1DCD3E9B.quest_subtitle: "Пояс"
	quest.5EB7CE3A1DCD3E9B.title: "&cУниверсальный магнит&r"
	quest.5F5E43B3F51CAE9E.quest_desc: [
		"«Они волшебно вкусны!» \\n\\n&aСуеверная шляпа&r даёт дополнительный уровень добычи при убийстве мобов! \\n\\nЭффект складывается с зачарованиями!"
	]
	quest.5F5E43B3F51CAE9E.quest_subtitle: "Голова"
	quest.5F5E43B3F51CAE9E.title: "&aСуеверная шляпа"
	quest.5FD6A738754F6013.quest_desc: [
		"Этот квест был создан &6командой AllTheMods&r или &2участником сообщества&r для использования в сборках AllTheMods.\\n\\nПоскольку все сборки &6AllTheMods&r защищены лицензией &eВсе права защищены&r, этот квест нельзя использовать в публичных сборках, не выпущенных &6командой AllTheMods&r, без явного разрешения.\\n\\nЭтот квест скрыт по умолчанию - если вы видите это сообщение, значит вы находитесь в режиме редактирования."
	]
	quest.623796B1D7981E59.quest_desc: [
		"'Попробуйте также Terraria!'\\n\\nКогда предмет надет, вы получите 5 дополнительных сердец! Или 10 единиц здоровья! В сумме это даёт 30 здоровья по умолчанию."
	]
	quest.623796B1D7981E59.quest_subtitle: "Пояс"
	quest.623796B1D7981E59.title: "&4Кристальное сердце&r"
	quest.62622137648A4F56.quest_desc: [
		"Разве вам не надоело добывать руду, а затем переплавлять её с помощью разных предметов? Теперь вы можете быть ленивее, чем когда-либо, с &7нагревателем кирки&r! \\n\\nКогда вы носите &7нагреватель кирки&r, добытая руда автоматически переплавляется! \\n\\nБудьте осторожны, если хотите обрабатывать руду."
	]
	quest.62622137648A4F56.quest_subtitle: "Руки"
	quest.62622137648A4F56.title: "&7Нагреватель кирки&r"
	quest.6A452BFC8A967C39.quest_desc: [
		"Ношение этих &aзвериных когтей&r вызывает особые ощущения. Адреналин зашкаливает, мысли исчезают, сила растёт как никогда! \\n\\nС &aзвериными когтями&r вы будете атаковать намного быстрее оружием или кулаками."
	]
	quest.6A452BFC8A967C39.quest_subtitle: "Руки"
	quest.6A452BFC8A967C39.title: "&aЗвериные когти&r"
	quest.6FBE5B5D5027B32C.quest_desc: [
		"Эта &7ковбойская шляпа&r заставит ваших животных бежать как ветер! \\n\\nДа и выглядит она лихо."
	]
	quest.6FBE5B5D5027B32C.quest_subtitle: "Голова"
	quest.6FBE5B5D5027B32C.title: "&7Ковбойская шляпа"
	quest.70C7D92844089DEB.quest_desc: [
		"Как и другие кулоны, этот может нанести урон вашему атакующему, но с помощью молнии! \\n\\nТакже защищает вас, если вам (не)повезёт быть поражённым молнией."
	]
	quest.70C7D92844089DEB.quest_subtitle: "Ожерелье"
	quest.70C7D92844089DEB.title: "&bШоковый кулон&r"
	quest.7188DC06A28AE30E.quest_desc: [
		"Ношение этого &eзолотого крюка&r увеличит количество опыта, получаемого от убитых врагов!"
	]
	quest.7188DC06A28AE30E.quest_subtitle: "Руки"
	quest.7188DC06A28AE30E.title: "&eЗолотой крюк&r"
	quest.72D6265E35814927.quest_desc: [
		"В большинстве игр с системой здоровья и урона есть кадры неуязвимости. После получения урона вы получите несколько кадров неуязвимости, чтобы 1. Не умереть мгновенно от простой атаки и 2. Дать вам время ответить. \\n\\nС &eнательным крестиком&r вы получаете больше кадров неуязвимости. А значит, больше времени для ответа!"
	]
	quest.72D6265E35814927.quest_subtitle: "Ожерелье"
	quest.72D6265E35814927.title: "&eНательный крестик&r"
	quest.73B73870B29DFAD9.quest_desc: [
		"«Один из нас! Один из нас!» \\n\\n&eШляпа крестьянина&r заставляет деревенских считать вас своим, убирая «налог для приезжих». Торговля становится дешевле."
	]
	quest.73B73870B29DFAD9.quest_subtitle: "Голова"
	quest.73B73870B29DFAD9.title: "&eШляпа крестьянина"
	quest.73FC51144FC2DA52.quest_desc: [
		"С этой &7перчаткой&r вы будете высасывать жизнь из всех врагов, которых ударите! \\n\\nОх, да, извините, я забыл... блех блех блеххх!"
	]
	quest.73FC51144FC2DA52.quest_subtitle: "Руки"
	quest.73FC51144FC2DA52.title: "&7Вампирская перчатка&r"
	quest.74B352457BF1541B.quest_desc: [
		"Если вы, как и я или любой здравомыслящий человек, ненавидите рыхлый снег, то &l&3Artifacts&r дают нам инструмент для борьбы с ним! Снегоступы! \\n\\nСнегоступы позволяют безопасно ходить по рыхлому снегу, как это делают кожаные ботинки. Также вы получите ускорение при ходьбе по любому снегу!"
	]
	quest.74B352457BF1541B.quest_subtitle: "Ноги"
	quest.7503823ACDDB0491.quest_desc: [
		"Этот шарф и &aсуеверная шляпа&r дают вам все необходимые амулеты удачи! \\n&2Шарф везения&r добавляет дополнительный уровень удачи к вашим киркам."
	]
	quest.7503823ACDDB0491.quest_subtitle: "Шарф (ожерелье)"
	quest.7503823ACDDB0491.title: "&2Шарф везения&r"
	quest.789AF6D0A6321945.quest_desc: [
		"Самый важный! Самый мощный! Самый опасный &l&3артефакт&r из всех!"
		"{@pagebreak}"
		"Я даже не уверен, стоит ли объяснять, что он делает, это слишком опасно!"
		"{@pagebreak}"
		"Если вы уверены, что справитесь с его силой, то, возможно, продолжайте читать..."
		"{@pagebreak}"
		"Ещё не поздно повернуть назад!"
		"{@pagebreak}"
		"Ладно, я предупредил..."
		"{@pagebreak}"
		"Нажмите Shift, чтобы с шансом выпустить газ, когда &dподушка-пердушка&r надета."
	]
	quest.789AF6D0A6321945.quest_subtitle: "Уникальный"
	quest.789AF6D0A6321945.title: "&dПодушка-пердушка&r"
	task.376652638B9221C9.title: "Все права защищены"
	task.68DC39876E14FC1B.title: "Убейте одного мимика"
	task.72E89066290E3040.title: "Все права защищены"
	chapter.0CC65817272B53A4.title: "Данжи и приключения"
	quest.2120FC8CCEE55FE9.title: "Карта приключений"
	quest.2120FC8CCEE55FE9.quest_subtitle: "Начало"
	quest.2120FC8CCEE55FE9.quest_desc: [
		"В мире теперь много структур: подземелья, башни, таверны, крепости и корабли."

		"{@pagebreak}"

		"Возьмите &bNature's Compass&r — он ищет нужные биомы."

		"Если в мире разрешены команды, структуру можно найти так: &e/locate structure <id>&r."

		"{@pagebreak}"

		"Каждая следующая глава квестов ведёт к новой структуре. Берите еду, запас факелов и хорошую броню — многие места опасны."
	]
	quest.99363C9930CF43AC.title: "Скелетное подземелье"
	quest.99363C9930CF43AC.quest_subtitle: "Yung's Better Dungeons"
	quest.99363C9930CF43AC.quest_desc: [
		"Найдите и зайдите в подземелье со скелетами. Внутри сундуки и спавнеры — берите оружие и щит."
	]
	quest.6889C91E3005A706.title: "Зомби-подземелье"
	quest.6889C91E3005A706.quest_subtitle: "Yung's Better Dungeons"
	quest.6889C91E3005A706.quest_desc: [
		"Зомби любят толпой. Заходите в подземелье осторожно, по одному коридору."
	]
	quest.3A31AADC19E3ECBF.title: "Паучье подземелье"
	quest.3A31AADC19E3ECBF.quest_subtitle: "Yung's Better Dungeons"
	quest.3A31AADC19E3ECBF.quest_desc: [
		"Паутина и пещерные пауки: возьмите ножницы или меч и противоядие (молоко)."
	]
	quest.071674EE0693E0D9.title: "Ведьмина хижина"
	quest.071674EE0693E0D9.quest_subtitle: "Yung's Better Witch Huts"
	quest.071674EE0693E0D9.quest_desc: [
		"Болотная хижина ведьмы. Осторожно с зельями."
	]
	quest.6BE1E08A7E114E68.title: "Таверна"
	quest.6BE1E08A7E114E68.quest_subtitle: "Dungeons and Taverns"
	quest.6BE1E08A7E114E68.quest_desc: [
		"Заглянете в деревянную таверну. Внутри можно найти припасы и ночлег."
	]
	quest.8DE424016B820FE4.title: "Крипта нежити"
	quest.8DE424016B820FE4.quest_subtitle: "Dungeons and Taverns"
	quest.8DE424016B820FE4.quest_desc: [
		"Подземная крипта с нежитью. Берите свет и хорошее оружие."
	]
	quest.0A727244D2A65227.title: "Ползучая крипта"
	quest.0A727244D2A65227.quest_subtitle: "Dungeons and Taverns"
	quest.0A727244D2A65227.quest_desc: [
		"Мрачный склеп с криперами. Не пускайте их в тесный коридор."
	]
	quest.141337ACF1E2B441.title: "Усадьба иллагеров"
	quest.141337ACF1E2B441.quest_subtitle: "Dungeons and Taverns"
	quest.141337ACF1E2B441.quest_desc: [
		"Усадьба разбойников-иллагеров с охраной."
	]
	quest.6EDE80A3BA89E31D.title: "Форт иллагеров"
	quest.6EDE80A3BA89E31D.quest_subtitle: "When Dungeons Arise"
	quest.6EDE80A3BA89E31D.quest_desc: [
		"Большая крепость иллагеров. Одному идти не стоит: возьмите друзей."
	]
	quest.C6C4EE2E3B9EFAD5.title: "Башни бандитов"
	quest.C6C4EE2E3B9EFAD5.quest_subtitle: "When Dungeons Arise"
	quest.C6C4EE2E3B9EFAD5.quest_desc: [
		"Башни бандитов с лучниками и ловушками."
	]
	quest.BE6FA6127EA696C3.title: "Приют чумы"
	quest.BE6FA6127EA696C3.quest_subtitle: "When Dungeons Arise"
	quest.BE6FA6127EA696C3.quest_desc: [
		"Заражённая лечебница. Возьмите зелья и крепкую броню."
	]
	quest.E25C7C4AE65CB5DB.title: "Заражённый храм"
	quest.E25C7C4AE65CB5DB.quest_subtitle: "When Dungeons Arise"
	quest.E25C7C4AE65CB5DB.quest_desc: [
		"Храм, кишащий чешуйницами. Ищите вход среди камней."
	]
	quest.3500F48AB489CB10.title: "Крепость Кайры"
	quest.3500F48AB489CB10.quest_subtitle: "When Dungeons Arise"
	quest.3500F48AB489CB10.quest_desc: [
		"Одна из самых больших структур мода. Берите запас еды и зелий."
	]
	quest.62734460417AE7FB.title: "Шахтный комплекс"
	quest.62734460417AE7FB.quest_subtitle: "When Dungeons Arise"
	quest.62734460417AE7FB.quest_desc: [
		"Большая шахта с хранилищами и особыми зачарованиями."
	]
	quest.2C442A3AD00F1436.title: "Механическое гнездо"
	quest.2C442A3AD00F1436.quest_subtitle: "When Dungeons Arise"
	quest.2C442A3AD00F1436.quest_desc: [
		"Механическое логово и вход в шахты глубже."
	]
	quest.7C3C2F9F335B53E5.title: "Пустынный храм"
	quest.7C3C2F9F335B53E5.quest_subtitle: "Yung's Better Desert Temples"
	quest.7C3C2F9F335B53E5.quest_desc: [
		"Ловушки и тайные комнаты под песком."
	]
	quest.53976270C78E175D.title: "Храм джунглей"
	quest.53976270C78E175D.quest_subtitle: "Yung's Better Jungle Temples"
	quest.53976270C78E175D.quest_desc: [
		"Храм в джунглях: ловушки, рычаги и сокровища."
	]
	quest.213B6DA5685F71AE.title: "Океанский монумент"
	quest.213B6DA5685F71AE.quest_subtitle: "Yung's Better Ocean Monuments"
	quest.213B6DA5685F71AE.quest_desc: [
		"Подводная крепость со стражами. Возьмите зелья дыхания под водой."
	]
	quest.5E4C955942756822.title: "Крепость"
	quest.5E4C955942756822.quest_subtitle: "Yung's Better Strongholds"
	quest.5E4C955942756822.quest_desc: [
		"Найдите крепость под землёй. Она ведёт в Край."
	]
	quest.F428D119E3DFF133.title: "Адская крепость"
	quest.F428D119E3DFF133.quest_subtitle: "Yung's Better Nether Fortresses"
	quest.F428D119E3DFF133.quest_desc: [
		"Крепость в Нижнем мире."
	]
	quest.1674844A519AABEC.title: "Донжон пиглинов"
	quest.1674844A519AABEC.quest_subtitle: "Dungeons and Taverns"
	quest.1674844A519AABEC.quest_desc: [
		"Крепость пиглинов. Наденьте золото и держите огнеупорные зелья под рукой."
	]
	quest.D64A860802F38533.title: "Замок Края"
	quest.D64A860802F38533.quest_subtitle: "Dungeons and Taverns"
	quest.D64A860802F38533.quest_desc: [
		"Замок на островах Края."
	]
	quest.1E0E94DACDCA2A59.title: "Мастер данжей"
	quest.1E0E94DACDCA2A59.quest_subtitle: "Финал"
	quest.1E0E94DACDCA2A59.quest_desc: [
		"Вы прошли главные подземелья мира. Забирайте награду и идите дальше: Cataclysm, Twilight Forest и Deeper Darker ждут."
	]
	task.3056DFADA05552BE.title: "Найдите: Скелетное подземелье"
	task.C0450C5C86166DEC.title: "Найдите: Зомби-подземелье"
	task.95E30255B5D45D27.title: "Найдите: Паучье подземелье"
	task.B49F8D70989DA94A.title: "Найдите: Ведьмина хижина"
	task.C02AEDEBA2F6AA9E.title: "Найдите: Таверна"
	task.A087CC556F4BE6E8.title: "Найдите: Крипта нежити"
	task.3E60CA3809906D54.title: "Найдите: Ползучая крипта"
	task.564B1DD7CDEE32A2.title: "Найдите: Усадьба иллагеров"
	task.0F276F7FD5562BFA.title: "Найдите: Форт иллагеров"
	task.3892543B0FDF7BC0.title: "Найдите: Башни бандитов"
	task.8B1E1BC8CD7CBF52.title: "Найдите: Приют чумы"
	task.3060D10A946FE4FF.title: "Найдите: Заражённый храм"
	task.3985F9E7AC6C785B.title: "Найдите: Крепость Кайры"
	task.15A7DB7DF35032D8.title: "Найдите: Шахтный комплекс"
	task.88784399D488568F.title: "Найдите: Механическое гнездо"
	task.FB6C68D5B547B182.title: "Найдите: Пустынный храм"
	task.6681D9241DD87B27.title: "Найдите: Храм джунглей"
	task.87EC348182DAD535.title: "Найдите: Океанский монумент"
	task.1DCB523513030A49.title: "Найдите: Крепость"
	task.794EA4975B9652EF.title: "Найдите: Адская крепость"
	task.AE554A5B0F1521D0.title: "Найдите: Донжон пиглинов"
	task.813555B112B0FE9C.title: "Найдите: Замок Края"
	quest.99363C9930CF43AC.title: "Эффективность"
	quest.99363C9930CF43AC.quest_desc: [
		"Модуль эффективности ускоряет работу лазера. Чем выше уровень модуля, тем быстрее идёт добыча."
	]
	quest.BE6FA6127EA696C3.title: "Дальность"
	quest.BE6FA6127EA696C3.quest_desc: [
		"Модуль дальности увеличивает расстояние, с которого лазер добывает блоки."
	]
	quest.D64A860802F38533.title: "Площадь 5×5"
	quest.D64A860802F38533.quest_desc: [
		"Расширенный модуль позволяет добывать сразу область 5×5 блоков."
	]
	quest.9063204D4E6752C1.title: "Заморозка"
	quest.9063204D4E6752C1.quest_desc: [
		"Модуль заморозки для шахтёрского лазера. Устанавливается в столе модификаций."
	]
	quest.95E30255B5D45D27.title: "Ёмкая батарея"
	quest.95E30255B5D45D27.quest_desc: [
		"Батарея второго уровня увеличивает запас энергии гаджета, чтобы его хватало на более долгую работу."
	]
	quest.A52DD713B80A40B6.title: "Шахтёрский фонарь"
	quest.A52DD713B80A40B6.quest_desc: [
		"Источник света для подземных работ: пригодится в длинных тоннелях."
	]
	quest.C83E8BAF538499D9.title: "Подзорная труба"
	quest.C83E8BAF538499D9.quest_desc: [
		"Позволяет рассмотреть далёкие постройки и не пропустить интересные места на пути."
	]
	quest.E02071366047B633.title: "Компас возвращения"
	quest.E02071366047B633.quest_desc: [
		"Указывает на место вашей последней смерти. Поможет вернуть потерянные вещи."
	]
	quest.9CB9557B327BD25B.title: "Эндер-сундук"
	quest.9CB9557B327BD25B.quest_desc: [
		"Все ваши эндер-сундуки открывают одно и то же хранилище, поэтому вещи всегда под рукой."
	]
	quest.8B1E1BC8CD7CBF52.title: "Варп-плита"
	quest.8B1E1BC8CD7CBF52.quest_desc: [
		"Плиты быстрого перемещения помогают быстро добираться между важными точками базы."
	]
	quest.AFA98C2177F38F49.title: "Элитры"
	quest.AFA98C2177F38F49.quest_desc: [
		"Крылья для планирования. Их можно найти в кораблях городов Края; вместе с фейерверками они ускоряют любые путешествия."
	]
	quest.88784399D488568F.title: "Корзина"
	quest.88784399D488568F.quest_desc: [
		"Удобная корзина для хранения продуктов на кухне."
	]
	quest.A704BAAD5793637E.title: "Рис"
	quest.A704BAAD5793637E.quest_desc: [
		"Рис растёт на мелководье и входит во многие рецепты."
	]
	quest.85F6E63FE2CDE537.title: "Яблочный пирог"
	quest.85F6E63FE2CDE537.quest_desc: [
		"Сытный десерт из яблок."
	]
	quest.AE554A5B0F1521D0.title: "Ягодный чизкейк"
	quest.AE554A5B0F1521D0.quest_desc: [
		"Десерт из сладких ягод."
	]
	quest.C8B8DEB8872CB62D.title: "Чайный лист"
	quest.C8B8DEB8872CB62D.quest_desc: [
		"Листья нужны для приготовления чая в чайнике."
	]
	quest.4A0DDDF4BE034AEB.title: "Торт"
	quest.4A0DDDF4BE034AEB.quest_desc: [
		"Классический торт: хороший повод отметить успехи на базе."
	]
	quest.FE4FF0AAA8BF84AF.title: "Набор пластин"
	quest.FE4FF0AAA8BF84AF.quest_desc: [
		"Набор деталей для сборки пластин брони."
	]
	quest.30EC2DDCB7454771.title: "Набор снаряжения"
	quest.30EC2DDCB7454771.quest_desc: [
		"Заготовка для сборки снаряжения Protection Pixel."
	]
	quest.E98E0686826035DF.title: "Жаропрочная керамика"
	quest.E98E0686826035DF.quest_desc: [
		"Лист жаропрочной керамики: нужен для деталей, которые должны выдерживать нагрев."
	]
	quest.AC2A9F6A86E026A2.title: "Аванпост разбойников"
	quest.AC2A9F6A86E026A2.quest_desc: [
		"Найдите аванпост разбойников. Осторожно: рядом может быть засада и патрули."
	]
	task.296336056B805353.title: "Найдите: Аванпост разбойников"
	quest.0296F3CEDC6B3596.title: "Заброшенная шахта"
	quest.0296F3CEDC6B3596.quest_desc: [
		"Отыщите заброшенную шахту. Возьмите факелы и оружие."
	]
	task.D329BF8E3514327C.title: "Найдите: Заброшенная шахта"
	quest.15B62E285EBBAE3B.title: "Лесной особняк"
	quest.15B62E285EBBAE3B.quest_desc: [
		"Особняк иллагеров в тёмном лесу: опасное и богатое место."
	]
	task.69B00AA82D06EF13.title: "Найдите: Лесной особняк"
	quest.EA8B7D658505DBAA.title: "Камеры испытаний"
	quest.EA8B7D658505DBAA.quest_desc: [
		"Подземный комплекс испытаний с генераторами мобов и наградами."
	]
	task.0019981F9638FB35.title: "Найдите: Камеры испытаний"
	quest.9F6A6FBE1C3E135B.title: "Бастион"
	quest.9F6A6FBE1C3E135B.quest_desc: [
		"Руины бастиона в Нижнем мире: пиглины и ценная добыча."
	]
	task.AC1B7B7BA596CBBE.title: "Найдите: Бастион"
	quest.1A7763B665C40BA3.title: "Древний город"
	quest.1A7763B665C40BA3.quest_desc: [
		"Глубокий тёмный город с хранителем. Двигайтесь тихо."
	]
	task.F0CFBD4802CC98C3.title: "Найдите: Древний город"
	quest.8510E7E7D2C5D1C2.title: "Крыло"
	quest.8510E7E7D2C5D1C2.quest_desc: [
		"Крылья добавляют подъёмную силу воздушным конструкциям."
	]
	quest.75C78C9AA7F3BDCD.title: "Двигатель Стирлинга"
	quest.75C78C9AA7F3BDCD.quest_desc: [
		"Тепловой двигатель, который превращает тепло горелки в энергию."
	]
	quest.489A1273424BFDBA.title: "Жидкостная горелка"
	quest.489A1273424BFDBA.quest_desc: [
		"Горелка на жидком топливе для питания двигателей."
	]
	quest.2D3BA8CF7C1F0D33.title: "Автосборка"
	quest.2D3BA8CF7C1F0D33.quest_desc: [
		"Инструмент: правый щелчок по блоку собирает связанную конструкцию, а по готовой разбирает её."
	]
	quest.2459826D28C3161C.title: "Автоклей"
	quest.2459826D28C3161C.quest_desc: [
		"Одним щелчком создаёт медовый клей над всей связанной конструкцией."
	]
	quest.E4EE4F0217F795D9.title: "Конденсатор"
	quest.E4EE4F0217F795D9.quest_desc: [
		"Накопитель для электрической части Create Crafts & Additions."
	]
	quest.4EDAEDE6BDB8F021.title: "Цифровой адаптер"
	quest.4EDAEDE6BDB8F021.quest_desc: [
		"Цифровой адаптер из Create Crafts & Additions."
	]
	quest.51263872B1B703AF.title: "Латунная коробка передач"
	quest.51263872B1B703AF.quest_desc: [
		"Улучшенная коробка передач из Create: Connected."
	]
	quest.16A41E0E45FC52B2.title: "Катализатор заморозки"
	quest.16A41E0E45FC52B2.quest_desc: [
		"Катализатор для вентилятора: замораживает предметы, проходящие через поток."
	]
	quest.CC89F3AA6BE9E24D.title: "Атлас жил"
	quest.CC89F3AA6BE9E24D.quest_desc: [
		"Помогает искать жилы руды для бурильной установки."
	]
	quest.3249B1E0C9F7DA08.title: "Разбрызгиватель"
	quest.3249B1E0C9F7DA08.quest_desc: [
		"Автоматически поливает посевы и помогает фермам Create."
	]
	quest.73401C8819CA5E32.title: "Большое флюкс-хранилище"
	quest.73401C8819CA5E32.quest_desc: [
		"Хранилище следующего уровня для флюкс-сети."
	]
	quest.E55ADCCA752B2FE6.title: "Флюкс-конфигуратор"
	quest.E55ADCCA752B2FE6.quest_desc: [
		"Инструмент для настройки устройств Flux Networks."
	]
	quest.1D13CD81BD0CBCB8.title: "Улучшенный модуль Pipez"
	quest.1D13CD81BD0CBCB8.quest_desc: [
		"Ускоряет и усиливает передачу по трубам Pipez."
	]
	quest.7EA4DA4B169E56FA.title: "Ветрогенератор"
	quest.7EA4DA4B169E56FA.quest_desc: [
		"Вырабатывает энергию ветром: чем выше, тем лучше."
	]
	quest.2C3D9BEB2C74CB94.title: "Биогенератор"
	quest.2C3D9BEB2C74CB94.quest_desc: [
		"Сжигает биотопливо и вырабатывает энергию."
	]
	quest.8CBC0F29CE433885.title: "Как устроены главы"
	quest.8CBC0F29CE433885.quest_desc: [
		"Слева список глав. «Гайд: путь развития» — основная линия сборки, остальные группы — дополнительные темы."
	]
	quest.3A5DEC37E6F263CC.title: "Награды"
	quest.3A5DEC37E6F263CC.quest_desc: [
		"Выполненный квест даёт награду. Нажмите на неё, чтобы забрать."
	]
	quest.593388F68612A82B.title: "Рецепты в JEI"
	quest.593388F68612A82B.quest_desc: [
		"Наведите курсор на предмет и нажмите R, чтобы увидеть рецепт, или U, чтобы увидеть, где он применяется."
	]
	chapter.63F17F68335641EC.title: "&6Create: Дизельные двигатели"
	chapter.63F17F68335641EC.chapter_subtitle: [
		"Нефть, биотопливо и моторы для самолётов"
	]
	quest.C7A46F74EF9513C3.title: "&6&lДизельная эра"
	quest.C7A46F74EF9513C3.quest_subtitle: "Сделайте поршень двигателя"
	quest.C7A46F74EF9513C3.quest_desc: [
		"&6Create: Diesel Generators&r добавляет &eдвигатели внутреннего сгорания&r — они крутят валы Create на жидком топливе."
		""
		"Всё начинается с &6поршня двигателя&r. Рецепт смотрите в JEI (R), подсказки — зажмите &eW&r (Ponder)."
	]
	quest.34D1BCED791147D7.title: "Дизельный двигатель"
	quest.34D1BCED791147D7.quest_subtitle: "Первый мотор"
	quest.34D1BCED791147D7.quest_desc: [
		"&6Дизельный двигатель&r даёт вращение, пока в него подаётся топливо по трубе."
		""
		"Подойдёт любое топливо из этой главы: &eрастительное масло&r, &eэтанол&r, &eбиодизель&r, &eбензин&r, &eдизель&r. Чем лучше топливо — тем больше скорость и нагрузка (смотрите очки инженера)."
	]
	quest.BBC59EB105B18324.title: "Модульный двигатель"
	quest.BBC59EB105B18324.quest_subtitle: "Ставьте в ряд"
	quest.BBC59EB105B18324.quest_desc: [
		"&6Модульный дизельный двигатель&r собирается в цепочку вдоль вала — каждый новый блок добавляет мощности."
		""
		"Отлично подходит для заводов, которым мало водяных колёс и паровых двигателей."
	]
	quest.840EFC8894FFBFDE.title: "Огромный двигатель"
	quest.840EFC8894FFBFDE.quest_subtitle: "Мощь как у паровой машины"
	quest.840EFC8894FFBFDE.quest_desc: [
		"&6Огромный дизельный двигатель&r — дизельный аналог паровой машины: ставится на бак и вал, к нему добавляются &eприводные валы&r."
		""
		"Самый мощный источник вращения в моде."
	]
	quest.9A5EC31676CB01B8.title: "Турбонаддув"
	quest.9A5EC31676CB01B8.quest_subtitle: "Больше оборотов"
	quest.9A5EC31676CB01B8.quest_desc: [
		"&6Турбонаддув&r ставится на двигатель (ПКМ) и повышает его отдачу."
	]
	quest.BD0D38CCE2B759E7.title: "Глушитель"
	quest.BD0D38CCE2B759E7.quest_subtitle: "Тише, соседи спят"
	quest.BD0D38CCE2B759E7.quest_desc: [
		"&6Глушитель&r убирает шум двигателя. Ваши соседи по серверу скажут спасибо."
	]
	quest.5676E19C94E6C7F3.title: "Растительное масло"
	quest.5676E19C94E6C7F3.quest_subtitle: "Простейшее топливо"
	quest.5676E19C94E6C7F3.quest_desc: [
		"Сожмите &eсемена&r в &6чаше&r механическим прессом (&eуплотнение&r) — получится &6растительное масло&r."
		""
		"Слабое, но самое доступное топливо для старта."
	]
	quest.1D990690AFAB4887.title: "Ферментер"
	quest.1D990690AFAB4887.quest_subtitle: "Бродильный цех"
	quest.1D990690AFAB4887.quest_desc: [
		"&6Объёмный ферментер&r собирается из нескольких блоков, как бак. Загрузите в него &eферментируемое&r (сахар, картофель, ягоды…) и &eкостную муку&r — получится &6этанол&r."
	]
	quest.1225A37C136585C8.title: "Этанол"
	quest.1225A37C136585C8.quest_subtitle: "Спирт для моторов"
	quest.1225A37C136585C8.quest_desc: [
		"&6Этанол&r — топливо среднего уровня и ингредиент биодизеля."
	]
	quest.3440F2F684A1C754.title: "Биодизель"
	quest.3440F2F684A1C754.quest_subtitle: "Зелёное топливо"
	quest.3440F2F684A1C754.quest_desc: [
		"Смешайте &6растительное масло&r и &6этанол&r (по 100 мБ) в чаше с &eмеханическим миксером&r — получится 200 мБ &6биодизеля&r."
		""
		"Хорошее топливо без нефти: можно жить только на фермах!"
	]
	quest.D345185F64CB43EB.title: "Сканер нефти"
	quest.D345185F64CB43EB.quest_subtitle: "Где копать?"
	quest.D345185F64CB43EB.quest_desc: [
		"&6Сканер нефти&r показывает, сколько нефти под текущим чанком."
		""
		"Нефть есть не везде — в некоторых биомах её больше (пустыни, океаны и т. п.). Ищите чанк с большим запасом."
	]
	quest.5C4E0C692CB937CD.title: "Станок-качалка"
	quest.5C4E0C692CB937CD.quest_subtitle: "Нефтяная вышка"
	quest.5C4E0C692CB937CD.quest_desc: [
		"&6Насосная установка&r качает нефть из чанка: &eотверстие&r ставится на землю, над ним &eголовка&r на рычаге, &eподшипник&r в середине и &eмеханический привод&r, который крутит валом."
		""
		"Соберите конструкцию по Ponder (W) — там показано точное расположение."
	]
	quest.8849872FB46CE97C.title: "Сырая нефть"
	quest.8849872FB46CE97C.quest_subtitle: "Чёрное золото"
	quest.8849872FB46CE97C.quest_desc: [
		"&6Сырая нефть&r горит в двигателе плохо — её нужно перегнать."
	]
	quest.6BC38D74959AFB4A.title: "Ректификационная колонна"
	quest.6BC38D74959AFB4A.quest_subtitle: "Перегонка"
	quest.6BC38D74959AFB4A.quest_desc: [
		"Поставьте несколько &eбаков Create&r друг на друга и установите на них &6контроллеры дистилляции&r — получится &6ректификационная колонна&r."
		""
		"Под ней нужна &eгорящая горелка ифрита&r (нагрев). С каждого яруса выходит своя фракция."
	]
	quest.CFB7360B87874FA3.title: "&eДизель и бензин"
	quest.CFB7360B87874FA3.quest_subtitle: "Лучшее топливо"
	quest.CFB7360B87874FA3.quest_desc: [
		"Перегонка даёт &6дизель&r и &6бензин&r — самое мощное топливо для двигателей и самолётов."
		""
		"Храните их в баках или &eнефтяных бочках&r, переносите в &eканистрах&r."
	]
	quest.7C06B18432AB8CCB.title: "Канистра"
	quest.7C06B18432AB8CCB.quest_subtitle: "Топливо с собой"
	quest.7C06B18432AB8CCB.quest_desc: [
		"&6Канистра&r хранит жидкость и может заправлять двигатели прямо в полёте."
	]
	quest.57ECDABDA6C2B6FE.title: "&bПортативный двигатель"
	quest.57ECDABDA6C2B6FE.quest_subtitle: "Мотор для летательных аппаратов"
	quest.57ECDABDA6C2B6FE.quest_desc: [
		"&bПортативный двигатель&r из Create Aeronautics крутит пропеллеры прямо на физической конструкции."
		""
		"С аддоном &bAeronautical Diesel&r он работает не только на угле, но и на &6жидком топливе&r из этой главы."
		""
		"Сдайте свежескрафченный (красный) двигатель — покрасить можно потом."
	]
	quest.2A525F12954B5474.title: "Топливный бак"
	quest.2A525F12954B5474.quest_subtitle: "Бак на борту"
	quest.2A525F12954B5474.quest_desc: [
		"&6Топливный бак&r ставится рядом с портативными двигателями на корабле и питает их жидким топливом."
		""
		"Чем больше баков — тем дальше полёт."
	]
	quest.97F58DCFA353964E.title: "Заправочная горловина"
	quest.97F58DCFA353964E.quest_subtitle: "Заправка на стоянке"
	quest.97F58DCFA353964E.quest_desc: [
		"&6Заправочная горловина&r позволяет заливать топливо в баки корабля трубой, помпой или из канистры — удобно сделать «заправку» на аэродроме."
	]
	quest.393DC8371D18F3A2.title: "Рычаг отсечки"
	quest.393DC8371D18F3A2.quest_subtitle: "Стоп, мотор!"
	quest.393DC8371D18F3A2.quest_desc: [
		"&6Рычаг отсечки двигателя&r перекрывает подачу топлива — двигатели глохнут и не тратят топливо на стоянке."
	]
	quest.1B3638262D888543.title: "&b&lДизельный самолёт"
	quest.1B3638262D888543.quest_subtitle: "Взлёт!"
	quest.1B3638262D888543.quest_desc: [
		"Постройте летательный аппарат с &bпортативными двигателями&r, &6топливным баком&r и залейте &eдизель&r или &eбензин&r."
		""
		"Взлетите и отметьте квест галочкой. Удачного полёта, пилот!"
	]
}
