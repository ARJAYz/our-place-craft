	quest.79110ACAAC8412EA.title: "Тертиевая пчела"
	quest.7941938014E97A30.quest_desc: [
		"Ты когда-нибудь хотел полетать на пчеле?\\n\\nШмели естественным образом появляются в мире, и их можно использовать как ездовых животных!\\n\\nСделай себе &6угощение на палочке&r, надень седло на шмеля и взлетай в небо!"
	]
	quest.7941938014E97A30.quest_subtitle: "Появляется в гнезде шмеля в Верхнем мире"
	quest.7941938014E97A30.title: "Шмель"
	quest.79CA2F401982C04F.quest_subtitle: "Скормите арканусовой пчеле блок рун"
