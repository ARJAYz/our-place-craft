	quest.543F00603790AD3E.quest_desc: [
		"Съёмник (брёвен) автоматически очищает брёвна от коры, используя топоры, помещённые в машину."
	]
	quest.543F00603790AD3E.quest_subtitle: "Только не при детях"
	quest.543F00603790AD3E.title: "Очистка"
	quest.54E7967B45B20F36.quest_subtitle: "Остролист + пурпурный креп-мирт"
	quest.5577F49A93ADB19C.quest_desc: [
		"&lProductive Trees&r — это сестринский мод для &lProductive Bees&r.\\n\\nЧтобы получить разные деревья, тебе понадобятся опыленные листья. Для опыленных листьев нужна пыльца. Для пыльцы нужны пчёлы.\\n\\nПчёлы, опыляющие цветы рядом с деревьями, автоматически опыляют листья, или ты можешь использовать улучшение сита для пыльцы в улье, чтобы добывать и использовать пыльцу самостоятельно! Вот тебе одно в подарок!"
	]
	quest.5577F49A93ADB19C.title: "Productive Trees"
