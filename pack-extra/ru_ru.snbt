	task.151AF2F49AAEBBDA.title: "&aИндукционные ячейки"
	task.363BADA865C39474.title: "Все права защищены"
	task.496C4FDD2515EB24.title: "&aИндукционные провайдеры"
	task.59F0226D83026397.title: "Все права защищены"
	quest.003AA945CACCD641.quest_subtitle: "Создаётся на столе подношений"
	quest.003AA945CACCD641.title: "Глубинная пчела"
	quest.003FF3813A864BA1.quest_subtitle: "Скормите лавовой пчеле ведро странной материи"
	quest.003FF3813A864BA1.title: "Пчела странной материи"
	quest.0072C4F028C327CB.quest_subtitle: "Магмовая + кочевая"
	quest.0072C4F028C327CB.title: "Пылающая пчела"
	quest.00A17728A387B426.quest_desc: [
		"Деревянные гнёзда используются для приманивания пчёл-плотников и пчёл с синими полосками.\\n\\nГнёзда из тёмного дуба привлекают 3 разных пчёл.\\n\\nИх можно размещать в любом биоме Верхнего мира."
	]
	quest.00A17728A387B426.quest_subtitle: "Может использоваться в любом биоме Верхнего мира"
	quest.00A17728A387B426.title: "Деревянные гнёзда"
	quest.00FD36C207845895.quest_desc: [
		"Размести обсидиановое гнездо в Энде, чтобы приманить эту пчелу."
	]
	quest.00FD36C207845895.quest_subtitle: "&9Требует обсидиановое гнездо"
	quest.00FD36C207845895.title: "Драконовая пчела"
	quest.010A970FC91BD617.quest_subtitle: "Создаётся в плавильне сплавов"
	quest.010A970FC91BD617.title: "Соулариевая пчела"
	quest.019CC48531E7759B.quest_subtitle: "Создаётся в кузнице драконьей стали"
	quest.019CC48531E7759B.title: "Пчела из ледяной драконостали"
	quest.01F7F3589EBD8872.quest_subtitle: "Скорми любой из грибных пчёл коричневый гриб"
	quest.01F7F3589EBD8872.title: "Грибная пчела"
	quest.027FD9135DEC4949.quest_subtitle: "Приманивает призрачных пчёл, если разместить в Незере и дать слёзы гаста"
	quest.029AA03790F055E8.quest_subtitle: "Кристаллическая + пчела-каменщица"
	quest.029AA03790F055E8.title: "Золотая пчела"
