	quest.5621D5D63A456CC0.title: "&6★ &r&7Стальной компонент"
	quest.5621D5D63A456CC0.quest_desc: [
		"&6★ Ключевой квест!&r Выполните его, чтобы открыть: &e5. Mekanism&r."
		""
		"Выплавьте сталь в &cдоменной печи&r и сделайте &7стальной компонент&r — он нужен для металлургического заполнителя Mekanism."
	]
	chapter.4DF2D105A59DCC67.title: "&6Карта развития"
	chapter.4DF2D105A59DCC67.chapter_subtitle: [
