	quest.76A0592F4C294545.quest_desc: [
		"Пилорама режет брёвна на опилки и на большее число досок, чем ты получил бы при крафте. Опилки можно использовать для создания бумаги.\\n\\n - Брёвна фустика также дадут фустик.\\n - Брёвна бразильского дерева и логвуда также дадут гематоксилин."
	]
