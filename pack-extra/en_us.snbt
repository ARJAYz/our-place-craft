	quest.7D38BC3DB3406F51.quest_subtitle: "&6Unlocks: 2. Create"
	quest.051E0C85E7B71CE0.quest_subtitle: "&6Unlocks: 4. Basic Power"
	quest.0061B0577B1C4AEF.quest_desc: [
		"&cLocked until:&r &6★ Basic Tier&r (chapter 4. Mekanism)"
		""
	]
	chapter_group.5EEB207D06671AD1.title: "Create & Addons"
	quest.11DC60F4392456DE.title: "&b&lPhysics Contraptions"
	quest.11DC60F4392456DE.quest_desc: [
		"&bCreate Aeronautics&r adds &ephysics contraptions&r that really fly, float, drive and fall."
		""
		"The &6Physics Assembler&r turns blocks into one: select them with &eSuper Glue&r or &eHoney Glue&r, then hold right-click and pull the assembler lever."
		""
		"Assembled contraptions stay fully interactable. Disconnected parts split off, and a &aSlime Ball&r merges two contraptions."
		""
		"Hover the item in JEI and hold &eW&r to open its animated &bPonder&r scene."
	]
	quest.5ECE3359AD3C2D6D.quest_desc: [
		"&6Honey Glue&r is a handy Super Glue alternative for physics contraptions."
		""
		"Click two corners to create a glued area; &eCtrl + scroll&r grows or shrinks it."
		"It is safer for complex builds, where Super Glue may grab unwanted blocks."
	]
	quest.45CE921AE465E150.quest_desc: [
		"&6Envelope blocks&r form the walls of a balloon."
		""
		"They enclose a volume that generates &aLift&r when filled with Hot Air. Balloons fill from the top down, so they must be &eairtight&r."
		"Shafts can be encased in envelope to stay airtight. Blocks inside the balloon reduce its volume."
		""
		"Right-click with dye to paint them."
	]
	quest.4B95423416419F82.quest_desc: [
		"The &6Hot Air Burner&r fills the balloon above it with hot air when powered by &credstone&r."
		""
		"Its panel sets the maximum output, and the signal strength scales it. Several burners can feed one balloon."
		"Lift is limited by balloon size and weakens with altitude; the contraption settles where lift equals weight."
	]
	quest.1DC7D50C37F8A88B.quest_desc: [
		"The &6Steam Vent&r fills balloons with steam instead of hot air."
		""
		"Like Create steam engines, it needs &cheat&r, &9water&r and enough boiler space. Output is controlled like the burner."
	]
	quest.4D0EF322815EF6D1.quest_desc: [
		"The &6Altitude Sensor&r outputs redstone based on elevation; min and max are set in its UI."
		""
		"Wire it to a burner and your airship will hold its altitude by itself."
	]
	quest.47D6E0D306CB0FB3.quest_desc: [
		"&dLevitite Blend&r is a fluid that crystallizes into Levitite; see JEI for the recipe."
		""
		"Crystallization needs &cheat&r; nearby heat sources also start it. The crystal spreads through the whole fluid and cannot be recollected."
		"Some blocks used as a casting mould are destroyed in the process."
	]
	quest.5BA687D832E70629.quest_desc: [
		"Enough &dLevitite&r keeps a contraption afloat."
		""
		"It cannot gain altitude by itself, so add propellers or thrusters. It strongly resists slow movement but barely affects fast movement."
	]
	quest.59C50446A65ED389.quest_desc: [
		"The &6Propeller Bearing&r attaches to the block in front and produces &aThrust&r when spun."
		""
		"Any structure with at least two sail-like blocks is a valid propeller; more sails means more thrust."
		"Reverse the rotation or use a wrench to flip thrust. &eEngineer's Goggles&r show thrust and airflow."
	]
	quest.35B2D3528B8148F6.quest_desc: [
		"A ready-made &6propeller&r goes straight onto the bearing; wooden and andesite variants exist."
	]
	quest.397FAE95386ECBE0.quest_desc: [
		"The &6Gyroscopic Propeller Bearing&r tries to keep its propeller upright — ideal for &ehelicopters&r."
		""
		"Facing down, it stabilizes top-heavy builds. A redstone signal resets the tilt."
	]
	quest.239BC0C896DA1DAC.quest_desc: [
		"The &6Smart Propeller&r makes thrust and pitches along one axis to try to face upwards."
	]
	quest.6F453BA5CF36D58B.quest_desc: [
		"The &6Portable Engine&r burns fuel to make rotation — on-board power."
		""
		"It can run in either direction, and fuel can be inserted automatically."
	]
	quest.6120998501A9E71F.quest_desc: [
		"The &6Steering Wheel&r lets you control your contraption. Hover the item in JEI and hold &eW&r to open its animated &bPonder&r scene."
	]
	quest.146FB762CE4A2BBD.quest_desc: [
		"The &6Navigation Table&r emits a redstone signal towards the destination of a navigation item — the base of an autopilot."
	]
	quest.36183A88B2B9437A.quest_desc: [
		"The &6Wheel Mount&r holds wheel-like items for ground travel."
	]
	quest.239149C4571AA876.quest_desc: [
		"&6Tires&r come small, standard, large and monstrous. Four of them and you have a car!"
	]
	quest.1B8F66BD27CD8130.quest_desc: [
		"With &6Rock Cutting Wheels&r and a container, the &6Borehead Bearing&r becomes a &edrill&r."
		""
		"The more blocks it must break, the slower it runs; several bearings offset this."
	]
	quest.61BA2CF7F50BEA63.quest_desc: [
		"&6Rock Cutting Wheels&r break blocks in a range and attach to each other without glue."
	]
	quest.30A1753E17BE3111.quest_desc: [
		"&bCreate Propulsion&r: the &6Thruster&r gives directional thrust when powered; it runs on &eTurpentine&r (see JEI)."
	]
	quest.2DF3094718C26797.quest_desc: [
		"The &6Ion Thruster&r runs on &aFE&r energy instead of fuel."
	]
	quest.2C06BDB8D8F56413.quest_desc: [
		"The &6Vector Thruster&r can yaw and pitch its nozzle for precise control."
	]
	quest.21DBD1D39A8DCA03.quest_desc: [
		"The &6Redstone Thruster&r scales thrust with signal strength and rotation speed."
		""
		"Next come the &6Brass&r thruster (3×3×3, vectorable) and the &6Blaze&r thruster (fuel-powered, no stress)."
	]
	quest.3ACE6F33BACFB3D0.quest_desc: [
		"The &6Blaze Thruster&r burns fuel and consumes no kinetic stress."
	]
	quest.760DC650F91E1D4C.quest_desc: [
		"The &6Jetpack&r is worn on the chest and runs on &epressurized air&r like a Create Backtank — refill it the same way."
		""
		"It can later be upgraded to netherite."
	]
	chapter.1F589DC846685257.title: "&bCreate: Aeronautics"
	chapter.1F589DC846685257.chapter_subtitle: [
		"Airships, helicopters, cars and jetpacks"
	]
	quest.13904DEF1C11F735.quest_desc: [
		"&bCreate Crafts & Additions&r links Create with electricity."
		""
		"The &6Alternator&r turns rotation into &aFE&r that Mekanism, AE2 and other mods can use."
	]
	quest.147A4A40A0A04DC4.quest_desc: [
		"The &6Electric Motor&r does the reverse: it uses &aFE&r to output rotation at a configurable speed."
	]
	quest.571A022ACAC5B68C.quest_desc: [
		"The &6Accumulator&r stores energy; place several together to form one large storage."
	]
	quest.4C57219A6C12ACE8.quest_desc: [
		"The &6Rolling Mill&r turns ingots and sheets into &erods&r and &ewires&r."
	]
	quest.31400E2210435A10.title: "&6Wires and Connectors"
	quest.31400E2210435A10.quest_desc: [
		"Move energy through wires: place &6Connectors&r on machines and link them with a &6Spool&r."
		""
		"Large connectors and electrum wire handle longer distances and more power."
	]
	quest.4C46126461B1CD22.quest_desc: [
		"The &6Tesla Coil&r charges items on a depot below it with energy."
	]
	quest.3BE90F01FF01CF99.quest_desc: [
		"&bCreate: Enchantment Industry&r — experience as a fluid."
		""
		"The &6Grindstone Drain&r strips enchantments from items and turns them into &aliquid experience&r."
	]
	quest.202E5676877409A9.quest_desc: [
		"The &6Blaze Enchanter&r enchants items with liquid experience; an &eEnchanting Template&r selects the enchantment."
	]
	quest.46D01B2DF89897B9.quest_desc: [
		"The &6Printer&r copies books, including enchanted ones, using liquid experience."
	]
	quest.78A19317DC5C0EED.quest_desc: [
		"&bCreate Big Cannons&r — real artillery."
		""
		"A cannon built from a breech, chambers and barrels sits on the &6Cannon Mount&r and is aimed by rotation."
	]
	quest.571386D302F06B90.quest_desc: [
		"Cannon parts are cast from molten metal and then bored with a &6Cannon Drill&r. Start with &7cast iron&r."
	]
	quest.7140BF7EAE849217.title: "&6Shells and Powder"
	quest.7140BF7EAE849217.quest_desc: [
		"A shot needs a &6projectile&r and a &6Powder Charge&r. Load them with a ram rod or cannon loader, then apply redstone."
	]
	quest.601CC3888976E334.quest_desc: [
		"&bCreate Ore Excavation&r: infinite &eore veins&r lie underground. The &6Vein Finder&r shows which one is below you."
	]
	quest.62617171444EA7C8.quest_desc: [
		"The &6Drilling Machine&r with a drill mines a vein while powered — veins are huge; the Extractor does the same for fluid veins."
	]
	quest.2B8ADEB7A4161293.quest_desc: [
		"&bCreate: Connected&r adds many handy parts."
		""
		"The &6Kinetic Battery&r stores rotation and releases it later. The mod also adds a brake, overstress clutch, six-way gearbox and item silo."
	]
	quest.259169841C8EAEE9.quest_desc: [
		"&6Fan Catalysts&r replace lava, fire or water in front of a fan, making bulk processing compact."
	]
	quest.143E83656F4CC69A.quest_desc: [
		"&bCopycats+&r: &6copycat blocks&r take the look of any block you click them with — slopes, steps, panels, doors and more."
	]
	quest.5C6D8339F42D47CC.quest_desc: [
		"&bCreate Deco&r — catwalks, railings, bars, lamps and sheet metal in Create style."
	]
	quest.5C1E7F05E037E5ED.title: "&bHypertubes"
	quest.5C1E7F05E037E5ED.quest_desc: [
		"&bCreate Hypertube&r: lay &6hypertubes&r and travel through them at high speed from an &6entrance&r."
	]
	quest.7C66D445436D76E2.quest_desc: [
		"&bSlice & Dice&r: the &6Slicer&r automates Farmer's Delight cutting board recipes, and the &6Sprinkler&r waters crops."
	]
	chapter.6E389ECB0C0FD195.title: "&6Create: Addons"
	chapter.6E389ECB0C0FD195.chapter_subtitle: [
		"Electricity, experience, cannons, drilling and more"
	]
	quest.41CFDE281223B513.quest_desc: [
		"&bFarmer's Delight&r makes food a real part of the game."
		""
		"The &6Knife&r is the main kitchen tool: cut ingredients on the &6Cutting Board&r, and get extra meat from animals."
	]
	quest.23A5249D3CEDDF2D.quest_desc: [
		"Place an item on the &6Cutting Board&r and click it with a knife, axe or pickaxe to slice it."
	]
	quest.3E220FF3AB4220A7.quest_desc: [
		"The &6Cooking Pot&r makes soups, stews and complex meals. Put it over a heat source; serve the result into bowls."
	]
	quest.45059E1936D8393A.quest_desc: [
		"The &6Stove&r is a handy heat source for pots and skillets, and grills several items at once."
	]
	quest.5C96D11521DF306F.quest_desc: [
		"The &6Skillet&r fries food over heat — and makes a decent weapon."
	]
	quest.70F1EDB1EF7DDC76.title: "&aNew Crops"
	quest.70F1EDB1EF7DDC76.quest_desc: [
		"New crops grow wild: &ctomatoes&r, &acabbage&r, &eonions&r and &frice&r. Gather and plant them."
		""
		"Rice is planted in water."
	]
	quest.49C14DA1922FE15A.quest_desc: [
		"&6Organic Compost&r slowly turns into &6Rich Soil&r, which speeds up plants and grows mushroom colonies."
	]
	quest.1F1A88947900F7F9.quest_desc: [
		"Feast dishes are placed as blocks and split into several servings — click them with a bowl."
	]
	quest.3C8A6090C8DCD19F.quest_desc: [
		"&bLet's Do Vinery&r — winemaking."
		""
		"Find &5grapes&r (each biome has its own), press juice in the &6Apple Press&r or &6Grapevine Pot&r, then age it in a &6Fermentation Barrel&r."
	]
	quest.341A8A79CEB81F9D.quest_desc: [
		"Wine gives useful effects and improves with age. Store bottles on racks and in wine boxes."
	]
	quest.54598BFD18D0752B.quest_desc: [
		"&bLet's Do Herbal Brews&r — tea and coffee."
		""
		"Gather tea leaves, dry them and brew in a &6Tea Kettle&r on a stove. Drinks grant nice effects."
	]
	quest.2D599F6F6E595ED3.quest_desc: [
		"&bOcean's Delight&r adds dishes from sea creatures: guardians, squid, pufferfish and kelp."
	]
	quest.349EFFDE6C6FA611.quest_desc: [
		"&bEnder's Delight&r — End cuisine with chorus, shulkers and endermites. Check JEI for where to get ingredients."
	]
	quest.6E9233D6778EEDB3.quest_desc: [
		"&bMore Delight&r and &bExpanded Delight&r add dozens more dishes: toasts, burgers, pasta, cheese and more."
	]
	chapter.2A4B7B1EDC1110C1.title: "&eKitchen and Drinks"
	chapter.2A4B7B1EDC1110C1.chapter_subtitle: [
		"Farmer's Delight, wine, tea and exotic dishes"
	]
	quest.5E2CA2C2944528C0.quest_desc: [
		"&6Waystones&r appear in villages and across the world. Right-click one to activate it."
		""
		"From any waystone you can then teleport to activated ones for a small experience cost."
	]
	quest.282433DDBF7B539B.quest_desc: [
		"The &6Warp Stone&r opens the waystone menu from anywhere; it needs time to recharge after use."
	]
	quest.3D0767F5958CA9BA.quest_desc: [
		"The &6Return Scroll&r is a one-time teleport back to your last waystone; other scrolls exist too."
	]
	quest.75AE7A3380BACD64.quest_desc: [
		"The &6Nature's Compass&r finds any &ebiome&r: pick one from the list and follow the needle."
	]
	quest.43FBF0FDDA4BD9CA.quest_desc: [
		"The &6Tool Belt&r goes in an accessory slot and holds several tools you can swap quickly; upgrade it up to netherite."
	]
	quest.41008631F5F59B22.quest_desc: [
		"The &6Sleeping Bag&r lets you sleep while travelling without changing your spawn point; a &6Hammock&r lets you rest by day."
	]
	quest.6CF8CAE814822F53.title: "&bCamera"
	quest.6CF8CAE814822F53.quest_desc: [
		"&bExposure&r: a real &6camera&r. Load film, take shots, develop the film and print photos in the &6Lightroom&r (see JEI)."
	]
	quest.6E501776ACDABACC.quest_desc: [
		"The &6Botany Pot&r grows crops and trees in a single block; the hopper version outputs the harvest by itself."
	]
	quest.33AEEAD73C365296.quest_desc: [
		"&bBaubley Heart Canisters&r: hearts dropped by monsters become &6canisters&r that permanently add health via the Heart Amulet."
	]
	quest.788638C51EB0E38A.quest_desc: [
		"The &6Akashic Tome&r merges all mod guidebooks into one book — combine them by crafting."
	]
	chapter.1BDD9F764BF50B52.title: "&aTravel and Comfort"
	chapter.1BDD9F764BF50B52.chapter_subtitle: [
		"Teleports, compasses, camping and handy tools"
	]
	quest.39F4F4275D481589.title: "&b&lMining Laser"
	quest.39F4F4275D481589.quest_desc: [
		"&bMining Gadgets&r — a laser drill powered by &aFE&r."
		""
		"Hold right-click to mine with the beam. Charge it in any charger: Mekanism, Flux Networks, Ender IO and others."
		""
		"There are three body variants: simple, standard and fancy. Any of them counts."
	]
	quest.246263D4A663F966.quest_desc: [
		"The &6Modification Table&r installs upgrades into the gadget and removes them."
	]
	quest.10936769B88197ED.quest_desc: [
		"The &6Blank Upgrade&r is the base for every other upgrade."
	]
	quest.614A14EB70B180A4.quest_desc: [
		"The &e3x3&r upgrade mines a whole square at once."
	]
	quest.61610D34F006DCC1.title: "&aFortune or Silk Touch"
	quest.61610D34F006DCC1.quest_desc: [
		"&aFortune&r gives more ore, &aSilk Touch&r mines blocks whole. You can only use one of them."
	]
	quest.706466213CA149BD.quest_desc: [
		"The &6Magnet&r pulls mined items straight into your inventory."
	]
	quest.31A3558E59D237B2.quest_desc: [
		"&6Void Junk&r destroys unwanted blocks like cobblestone; the list is configurable."
	]
	quest.638FF0297CA93045.quest_desc: [
		"The &6Light Placer&r automatically places Miner's Lights in dark spots."
	]
	quest.6985CCFD3EB640B8.quest_desc: [
		"The &6Battery&r upgrade increases energy capacity; tiers 2 and 3 go higher."
	]
	chapter.11D38CB881BC1703.title: "&bMining Gadgets"
	chapter.11D38CB881BC1703.chapter_subtitle: [
		"The laser drill and its upgrades"
	]
	quest.706D8CBCEF3B0F1F.title: "&6Loot Chests"
	quest.706D8CBCEF3B0F1F.quest_desc: [
		"&bLootr&r: chests, barrels and pots in dungeons and villages are now &eper-player&r — everyone gets their own loot."
		""
		"Such containers have a special texture, so you can explore with friends without stealing each other's loot."
		""
		"Click the checkmark to complete this quest."
	]
	quest.4D4F3FB2ABC703CC.title: "&6Engineer's Handbook"
	quest.4D4F3FB2ABC703CC.quest_subtitle: "A book about Create and its addons"
	quest.4D4F3FB2ABC703CC.quest_desc: [
		"Click the checkmark and claim the &6Engineer's Handbook&r."
		""
		"It explains &eCreate&r and every addon in this pack step by step: rotation, processing, logistics, contraptions, trains, Aeronautics, electricity, cannons and more."
		""
		"Lost it? Craft a new one from a &fbook&r and &7andesite alloy&r."
	]
	quest.6091765DCA3A9B66.title: "&6Create: Protection Pixel"
	quest.6091765DCA3A9B66.quest_desc: [
		"&bProtection Pixel&r adds heavy Create-style &6power armor&r: helmets, chestplates and leggings with special effects, armor plates, wings and gear."
		""
		"Almost everything is built on Create's &eMechanical Crafter&r. Start with &6Reinforced Fiber&r."
	]
	quest.6E1C85BD4CCA4865.quest_desc: [
		"&6Protective Lining Socks&r let your feet cope with heavy power armor."
	]
	quest.4BE579E149C33583.quest_desc: [
		"The &6Chestplate Lining&r is one of the parts for power armor. See JEI for recipes."
	]
	quest.13691D096732F7A0.quest_desc: [
		"&6Armor Plates&r attach to power armor for protection. Iron ones are made on the Mechanical Crafter."
		""
		"Hold &eShift&r over armor to see its plate system. Every plate adds weight."
	]
	quest.6FD57117BE366119.quest_desc: [
		"&6Brass Armor Plates&r are tougher than iron ones and are repaired with brass ingots on an anvil."
	]
	quest.64205A40836E5D23.quest_desc: [
		"&6Alloy Armor Plates&r are the best. They use &esequenced assembly&r and are repaired with netherite scrap."
	]
	quest.120C60468A8695E7.quest_desc: [
		"The &6Armor Load Platform&r installs and removes armor plates."
		""
		"It needs &clava&r piped in: each install or removal costs 100 mB, and it stores 200 mB. Also power the gear underneath."
	]
	quest.7D9E7695543A3A88.quest_desc: [
		"The &6Combustion Reactor&r goes into the power slot and powers the whole armor. Without it, armor functions stay off."
	]
	quest.240B4D626CFB4864.quest_desc: [
		"The &6Steam Booster&r lets you carry 3 more weight. Being overweight slows you down."
	]
	quest.5DD94E6ADFAA9514.quest_desc: [
		"The &6Plague Helmet&r clears blindness, weakness, slowness and darkness every 10 seconds and improves sight in fog."
		""
		"Each armor piece has an upgraded &eAS&r version with stronger effects."
	]
	quest.4D3D5AF4671DE27B.quest_desc: [
		"The &6Breaker Chestplate&r adds 3 damage to every attack. Other chestplates have wings, drones, shields and magnets."
	]
	quest.30CFC4DB5901B698.quest_desc: [
		"&6Slingshot Leggings&r give +10% speed and higher jumps. Other leggings reduce fall damage or let you walk on liquids."
	]
	quest.68B4618DD34CC9CA.quest_desc: [
		"The &6Susp-Jetpack&r keeps you hovering. It needs a Create Backtank. Activate by crouching and pressing Space."
	]
	quest.57BDC1C88F96D0F1.quest_desc: [
		"The &6Maneuvering Wing&r gives flight and speeds up your glide. You need room to build speed."
	]
	quest.48D5C0DFF96E121D.quest_desc: [
		"The &6Hook Cannon&r: crouch and press Space to fire a hook to climb quickly or grab prey."
	]
	quest.66F3F8DE1EDD7569.quest_desc: [
		"The &6Armor Hanger&r displays a chestplate, leggings and boots."
	]
	chapter.3AA17358C16C1C33.title: "&6Create: Protection Pixel"
	chapter.3AA17358C16C1C33.chapter_subtitle: [
		"Create-style power armor"
	]
	quest.4D0435819989021C.quest_desc: [
		"The &6Experience Hatch&r is the easiest way to turn your experience into liquid: right-click to store, Shift+right-click to take it back."
		""
		"Mobs killed by crushing wheels or deployers also drop experience."
	]
	quest.682455F3AD51180C.quest_desc: [
		"The &6Experience Lantern&r absorbs experience from nearby players and orbs. It also works on contraptions."
	]
	quest.7FAAA782066790E5.quest_desc: [
		"The &6Enchanting Template&r stores enchantments. Put a sample item in the Blaze Enchanter filter, and it will only roll enchantments valid for that item."
	]
	quest.44BDB4C1268F82B1.quest_desc: [
		"The &6Blaze Forger&r works like an anvil without repair cost. It applies templates to items, merges enchantments and strips them back into a template."
	]
	quest.5223A2B4E163EBC7.title: "&5Super Enchanting"
	quest.5223A2B4E163EBC7.quest_desc: [
		"Feed a Blaze Enchanter or Forger a &5Cake o' Enchanting&r to enter &5Super Enchanting&r mode."
		""
		"It lets you exceed level caps, merge conflicting enchantments and get treasure enchantments."
		""
		"&cWarning:&r it causes lightning — place a lightning rod nearby."
	]
	chapter.7AF827D2D101D343.title: "&dArtifacts"
	quest.010607466D565B53.quest_desc: [
		"Like get in touch with Mother Nature man. \\n\\nWith &aRooted Boots&r nature is your Bestfriend! When standing on Grass you will Regenerate Hearts. Also when you Eat Food when standing on Grass it will act as if you Bonemealed it."
	]
	quest.010607466D565B53.quest_subtitle: "Feet"
	quest.010607466D565B53.title: "&aRooted Boots"
	quest.0A1D4228271DECA3.quest_desc: [
		"Where'd you go?\\n\\nOh you're just half your previous size. Small enough to fit beneath a 1 Block gap."
	]
	quest.0A1D4228271DECA3.quest_subtitle: "Necklace"
	quest.0A1D4228271DECA3.title: "&5Charm of Shrinking&r"
	quest.0E716B90E60C486B.quest_desc: [
		"Some times the best way to fight, is not to fight.. it's to run away! \\n\\nWith the &4Panic Necklace&r, when hit you will get Speed Effect for a small time. Just enough time to get away!"
	]
	quest.0E716B90E60C486B.quest_subtitle: "Necklace"
	quest.0E716B90E60C486B.title: "&4Panic Necklace&r"
	quest.11C5F17C6BB1237B.quest_desc: [
		"While wearing the &5Withered Bracelet&r Melee Attacks have a chance to give the Wither Effect.\\n\\nSorry Bow users!"
	]
	quest.11C5F17C6BB1237B.quest_subtitle: "Wrists (Hands)"
	quest.11C5F17C6BB1237B.title: "&5Withered Bracelet&r"
	quest.122E6E7CABCB17E7.quest_desc: [
		"For some reason Creepers are scared of Cats. Creepers are also extremely dumb and believe the Cats that your &7Slippers&r look like are real. \\n\\nAll Creepers will run away from you and won't be hostile when these &7Slippers&r are worn. \\n\\nAlso makes Kitty noises when you take damage! (Can't assure you that you will always land on your Feet though)."
	]
	quest.122E6E7CABCB17E7.quest_subtitle: "Feet"
	quest.122E6E7CABCB17E7.title: "&7Kitty Slippers&r"
	quest.145E7D1A88B83DDD.quest_desc: [
		"Where'd you go?"
	]
	quest.145E7D1A88B83DDD.quest_subtitle: "Scarf (Necklace)"
	quest.145E7D1A88B83DDD.title: "&9Scarf of Invisibility&r"
	quest.161A90E134592D0E.quest_desc: [
		"Like regular Raw Beef, you can cook the &cEverlasting Beef&r to get &4Eternal Steak&r!\\n\\nWorks just like &cEverlasting Beef&r but more Food Points and Saturation."
	]
	quest.161A90E134592D0E.quest_subtitle: "Unique"
	quest.161A90E134592D0E.title: "&4Everlasting Steak"
	quest.16255FB20F35A9D9.quest_desc: [
		"The &3Snorkel&r gives you a small amount of Water Breathing when you enter &9Water&r. Similar to a Turtle Helmet! Careful though it runs out."
	]
	quest.16255FB20F35A9D9.quest_subtitle: "Head"
	quest.16255FB20F35A9D9.title: "&3Snorkel"
	quest.19B393433FB0C62F.quest_desc: [
		"The Strider's secret to walking on &cLava&r is within their Legs. So we took their Legs off of them and have you use them instead! \\n\\nWhen Sneaking you can walk safely ontop of &cLava&r! When you stop Sneaking you will fall into the &cLava&r though. These also allow you to safely walk over Magma blocks and other hot blocks!"
	]
	quest.19B393433FB0C62F.quest_subtitle: "Feet"
	quest.19B393433FB0C62F.title: "&4Strider Shoes&r"
	quest.1E40ACF3E69A4100.quest_desc: [
		"Do you have to drink it? Idk it kinda just stays there and works... \\n\\nWith the &6Antidote Vessel&r, negative Effects (like Wither or Poison) will have their durations cut short! Very helpful when facing Witches or Wither Skeletons."
	]
	quest.1E40ACF3E69A4100.quest_subtitle: "Belt"
	quest.1E40ACF3E69A4100.title: "&6Antidote Vessel&r"
	quest.2215FB0777D7029D.quest_desc: [
		"Spikes, Cleats, Crampons whatever they are! \\n\\n&7Steadfast Boots&r keep you steady on your Feet. You won't be knocked back from attacks and you won't slip on Ice anymore."
	]
	quest.2215FB0777D7029D.quest_subtitle: "Feet"
	quest.2215FB0777D7029D.title: "&7Steadfast Boots&r"
	quest.221C9EDA651144BA.quest_desc: [
		"What &9Water&r? \\n\\nWith the &3Charm of Sinking&r you move through the &9Water&r as if it were Air! Still can't breath underwater though..."
	]
	quest.221C9EDA651144BA.quest_subtitle: "Necklace"
	quest.221C9EDA651144BA.title: "&3Charm of Sinking&r"
	quest.2607F3DC07049785.quest_desc: [
		"Why spend time sitting down and eating a nice Home-Cooked meal when you can just Eat and Drink quickly! \\n\\nWith this very stylish &6Hat&r, Eating and Drinking is much faster."
	]
	quest.2607F3DC07049785.quest_subtitle: "Head"
	quest.2607F3DC07049785.title: "&6Plastic Drinking Hat"
	quest.27E951F4F4F6F847.quest_desc: [
		"Similar to &aThorn Pendant&r, just a little hotter. No wait way hotter! \\n\\nThe &cFlame Pendant&r has a chance to light your attackers on Fire! When they are lit on fire the &cPendant&r will also give you Fire Resistance."
	]
	quest.27E951F4F4F6F847.quest_subtitle: "Necklace"
	quest.27E951F4F4F6F847.title: "&cFlame Pendant&r"
	quest.29448D08C8777425.quest_desc: [
		"By tonight he'll be sleeping with the Fishes. \\n\\nThe &cAngler Hat&r helps you Lure Fish in and makes your chances at getting a Rare Drop higher!"
	]
	quest.29448D08C8777425.quest_subtitle: "Head"
	quest.29448D08C8777425.title: "&cAngler's Hat"
	quest.2AD78E22988A92D3.quest_desc: [
		"I see you! \\n\\nWhen wearing &2Night Vision Goggles&r you get the ability to see in the dark! Not much else to them..."
	]
	quest.2AD78E22988A92D3.quest_subtitle: "Head"
	quest.2AD78E22988A92D3.title: "&2Night Vision Goggles"
	quest.321F16645640C462.quest_desc: [
		"Enderpearls are a fun way of travel! (Helpful for the Bumblezone, I wonder if we'll get a Quest chapter for that Mod!) But don't you hate that the Enderpearl gets consumed on use and takes 2 Hearts of damage with each use? \\n\\nWith &9Warp Drive&r that all goes away, clearly making Enderpearls the greatest transportation! Hunger gets consumed instead of the Enderpearl and no longer take damage from using an Enderpearl. When all Hunger Bars are depleted it will go back to consuming Enderpearls."
	]
	quest.321F16645640C462.quest_subtitle: "Belt"
	quest.321F16645640C462.title: "&9Warp Drive&r"
	quest.3446803FB59D8875.quest_desc: [
		"Gives you Thorns. Not your Armor, you! Like a Pufferfish!"
	]
	quest.3446803FB59D8875.quest_subtitle: "Necklace"
	quest.3446803FB59D8875.title: "&aThorn Pendant&r"
	quest.3525D5DCC3A534D9.quest_desc: [
		"Now these are one of my favorites! \\n\\n&9Digging Claws&r will 1. Increase your Mining Speed, so basically a level of Efficiency on all Pickaxes, and 2. Makes your Fists act as a Stone Pickaxe! \\n\\nSuper helpful for building and just playing in general!"
	]
	quest.3525D5DCC3A534D9.quest_subtitle: "Hands"
	quest.3525D5DCC3A534D9.title: "&9Digging Claws&r"
	quest.3705D303CF423804.quest_desc: [
		"The other side of the &aFeral Claws&r, these increase the Damage you deal while wearing them."
	]
	quest.3705D303CF423804.quest_subtitle: "Hands"
	quest.3705D303CF423804.title: "&ePower Glove&r"
	quest.3B3BD39BA02DCA13.quest_desc: [
		"With the &6Pocket Piston&r your Attacks will hit your Enemies much farther! \\n\\nI wonder which wins, &6Pocket Piston&r or &7Steadfast Boots&r?"
	]
	quest.3B3BD39BA02DCA13.quest_subtitle: "Hands"
	quest.3B3BD39BA02DCA13.title: "&6Pocket Piston&r"
	quest.3E0643EA9183CDAE.quest_desc: [
		"'It was his Hat Mr Krabs! He was Number 1!' \\n\\nDoes the same exact thing as the normal &6Drinking Hat&r, just looks much cooler!"
	]
	quest.3E0643EA9183CDAE.quest_subtitle: "Head"
	quest.3E0643EA9183CDAE.title: "&9Novelty Drinking Hat"
	quest.3E1A3BC8642390B3.quest_desc: [
		"'I'm Marry Poppins ya'll!' \\n\\n&4The Umbrella&r is a very useful tool added by &l&3Artifacts&r! It can be held infront of you to work as a Shield, by holding Right Click. Or it can be used to slow your fall by just holding it! "
	]
	quest.3E1A3BC8642390B3.quest_subtitle: "Unique"
	quest.3E1A3BC8642390B3.title: "&4Umbrella&r"
	quest.3EC8A0B89788D079.quest_desc: [
		"I don't have Hands, I have &9Flippers&r. \\n\\n&9Flippers&r will act like a much better Depth Strider. You can Swim and Walk through &9Water&r much faster!"
	]
	quest.3EC8A0B89788D079.quest_subtitle: "Feet"
	quest.3EC8A0B89788D079.title: "&9Flippers&r"
	quest.427014BDE06DE631.quest_desc: [
		"Everything I hit, bursts into Flames!!!!!"
	]
	quest.427014BDE06DE631.quest_subtitle: "Hands"
	quest.427014BDE06DE631.title: "&cFire Gauntlet&r"
	quest.436E4E3515BCCDE9.quest_desc: [
		"With the &bCloud in a Bottle&r equipped you can hit Space Bar twice to double jump! Very helpful for parkour! \\n\\nAlso increases the height you can fall from, like &dBunny Hoppers&r!"
	]
	quest.436E4E3515BCCDE9.quest_subtitle: "Belt"
	quest.436E4E3515BCCDE9.title: "&bCloud in a Bottle&r"
	quest.4564B577CB4EC046.quest_desc: [
		"When slaughtering hundreds of Cows you might come across a Rare Beef. Not one with Mad Cow Disease, I mean the &cEverlasting Beef&r!\\n\\n&cEverlasting Beef&r can be eaten like a normal Raw Beef, but it won't be deleted when consumed! Instead it will have a cooldown before you can eat it again.\\n\\n(Also works with autofeeding backpacks!)"
	]
	quest.4564B577CB4EC046.quest_subtitle: "Unique"
	quest.4564B577CB4EC046.title: "&cEverlasting Beef&r"
	quest.4933CF4675E77D50.quest_desc: [
		"After you take a hit from Fire Damage, the &5Obsidian Skull&r will activate giving you a period of Fire Resistance. Hopefully long enough to escape the flames!"
	]
	quest.4933CF4675E77D50.quest_subtitle: "Belt"
	quest.4933CF4675E77D50.title: "&5Obsidian Skull&r"
	quest.4A7AEBEB87CEC274.quest_desc: [
		"I don't believe I have permission to use a specific brand name of &cRunning Shoes&r so use your imagination on which these are. \\n\\n&cRunning Shoes&r will give you a Speed Boost when Sprinting so you will be even faster when Running! Also gives you auto-jump when Sprinting..."
	]
	quest.4A7AEBEB87CEC274.quest_subtitle: "Feet"
	quest.4A7AEBEB87CEC274.title: "&cRunning Shoes&r"
	quest.4D3379D38237F830.quest_desc: [
		"While wearing &bthese&r on your Feet you can preform a miracle! Walking on &9Water&r! \\n\\nWell actually running on &9Water&r, you have to be Sprinting to be able to run over &9Water&r. Once you stop Sprinting you will start Sinking."
	]
	quest.4D3379D38237F830.quest_subtitle: "Feet"
	quest.4D3379D38237F830.title: "&bAqua-Dashers&r"
	quest.5040B3D29F238BC0.quest_desc: [
		"Bunny, hop. Bunny, hop. Bunny, hop.\\n\\nWith &dBunny Hoppers&r on you can jump twice as high and take half the fall damage as usual! Doesn't make you invincible to Fall Damage, you can still die it's just harder."
	]
	quest.5040B3D29F238BC0.quest_subtitle: "Feet"
	quest.5040B3D29F238BC0.title: "&dBunny Hoppers&r"
	quest.50A32AC6EDBC5854.quest_desc: [
		"Food by itself can get pretty boring, but it gets much better when you have a side with your dish! More specifically some (a) &6Onion Ring&r!\\n\\nWhen wearing the &6Onion Ring&r, everything you eat will give you slight Haste."
	]
	quest.50A32AC6EDBC5854.quest_subtitle: "Hands"
	quest.50A32AC6EDBC5854.title: "&6Onion Ring&r"
	quest.589F1D502F680075.quest_desc: [
		"Perfect for Pool Parties! \\n\\nBesides looking cute and funny the &dHelium Flamingo&r allows you to swim in Air. Yes you heard me! Swim... in... Air... \\n\\nWhen in the Air, like jumping, you can press CTRL to start Swimming in Air. You can move around just like in the Water: Swim up, Swim down, Swim all around!"
	]
	quest.589F1D502F680075.quest_subtitle: "Belt"
	quest.589F1D502F680075.title: "&dHelium Flamingo&r"
	quest.5CE44C58A470E48E.quest_desc: [
		"&l&3Artifacts&r is a wonderful Mod that adds &l&3Artifacts&r that will make your Minecraft expereince much easier and much more fun!\\n\\nAll &l&3Artifacts&r can either be found from exploring, archeology, or killing Mimics!\\n\\nMimics are found in Campsites underground, looking like normal Chests! But once you get too close they'll attack!"
	]
	quest.5CE44C58A470E48E.title: "&l&3Artifacts"
	quest.5DE7C4FD5FA29236.quest_desc: [
		"Don't you hate when you're just about to kill an Endermen and it teleports away? Well you don't hate you, you love it! You're just angry because you're envious! You want it! \\n\\nAnd with the &5Chorus Belt&r you can get it! You will teleport from a hit that would kill you."
	]
	quest.5DE7C4FD5FA29236.quest_subtitle: "Belt"
	quest.5DE7C4FD5FA29236.title: "&5Chorus Belt&r"
	quest.5EB7CE3A1DCD3E9B.quest_desc: [
		"It's a &cMagnet&r."
	]
	quest.5EB7CE3A1DCD3E9B.quest_subtitle: "Belt"
	quest.5EB7CE3A1DCD3E9B.title: "&cUniversal Attractor&r"
	quest.5F5E43B3F51CAE9E.quest_desc: [
		"'They're magically delicious!' \\n\\nThe &aSuperstitious Hat&r grants you an extra level of Looting to Mobs you kill! \\n\\nIt does stack with Enchants! "
	]
	quest.5F5E43B3F51CAE9E.quest_subtitle: "Head"
	quest.5F5E43B3F51CAE9E.title: "&aSuperstitious Hat"
	quest.5FD6A738754F6013.quest_desc: [
		"This Quest has been authored by &6AllTheMods Staff&r, or a &2Community contributor&r for use in AllTheMods Modpacks. \\n\\nAs all &6AllTheMods&r packs are licensed under &eAll Rights Reserved&r, this Quest is not allowed to be used in any public packs not released by &6AllTheMods Team&r without explicit permission. \\n\\nThis quest is intentionally hidden, if you're seeing this, you're in editing mode."
	]
	quest.623796B1D7981E59.quest_desc: [
		"'Also try Terraria!'\\n\\nWhen equipped you will gain 5 extra Hearts! Or 10 whole points of Health! Adding up to on default 30 Health."
	]
	quest.623796B1D7981E59.quest_subtitle: "Belt"
	quest.623796B1D7981E59.title: "&4Crystal Heart&r"
	quest.62622137648A4F56.quest_desc: [
		"Don't you hate having to Mine then Smelt your Ores with two different Items? Well now you can be lazier than ever with the &7Pickaxe Heater&r!\\n\\nWhile wearing the &7Pickaxe Heater&r, Ores that you Mined will automatically be Smelted!\\n\\nMight want to be careful with it if you want Ore Processing."
	]
	quest.62622137648A4F56.quest_subtitle: "Hands"
	quest.62622137648A4F56.title: "&7Pickaxe Heater&r"
	quest.6A452BFC8A967C39.quest_desc: [
		"Wearing these &aClaws&r just makes you feel a certain way. Adrenaline pumping, thoughts ceasing, strength rising like no other! \\n\\nWith &aFeral Claws&r you will Attack much faster with your Weapons or Fists."
	]
	quest.6A452BFC8A967C39.quest_subtitle: "Hands"
	quest.6A452BFC8A967C39.title: "&aFeral Claws&r"
	quest.6FBE5B5D5027B32C.quest_desc: [
		"Wearin' this here &7Hat&r makes yer critters run like the wind! \\n\\nIt's right purty too."
	]
	quest.6FBE5B5D5027B32C.quest_subtitle: "Head"
	quest.6FBE5B5D5027B32C.title: "&7Cowboy Hat"
	quest.70C7D92844089DEB.quest_desc: [
		"Like the other Pendants this has a chance to hurt your attacker, just with Lightning! \\n\\nAlso makes it so if you're (un)lucky enough to be hit by Lightning, it won't hurt you."
	]
	quest.70C7D92844089DEB.quest_subtitle: "Necklace"
	quest.70C7D92844089DEB.title: "&bShock Pendant&r"
	quest.7188DC06A28AE30E.quest_desc: [
		"Wearin' dis &eGolden Hook&r will increase yar yield of experience from keel-hauled enemies!"
	]
	quest.7188DC06A28AE30E.quest_subtitle: "Hands"
	quest.7188DC06A28AE30E.title: "&eGolden Hook&r"
	quest.72D6265E35814927.quest_desc: [
		"Most games that have a Health and Damage system, have Invincibility Frames. After you take Damage you will have a few Invincibility Frames so 1. You don't die in an instant by a simple attack and 2. Gives you time to fight back. \\n\\nWith &eCross Necklace&r you get a few more Invincibility Frames. Which means a few more times to fight back!"
	]
	quest.72D6265E35814927.quest_subtitle: "Necklace"
	quest.72D6265E35814927.title: "&eCross Necklace&r"
	quest.73B73870B29DFAD9.quest_desc: [
		"One of us! One of us! \\n\\nThe &eVillager Hat&r makes the Villagers believe you're from the same Town so they get rid of the Out-of-Towners Tax. Villager Trades are cheaper."
	]
	quest.73B73870B29DFAD9.quest_subtitle: "Head"
	quest.73B73870B29DFAD9.title: "&eVillager Hat"
	quest.73FC51144FC2DA52.quest_desc: [
		"With this &7Glove&r you will steal the life from any enemies you hit!\\n\\nOh yeah sorry I forgot... bleh bleh blehhh!"
	]
	quest.73FC51144FC2DA52.quest_subtitle: "Hands"
	quest.73FC51144FC2DA52.title: "&7Vampiric Glove&r"
	quest.74B352457BF1541B.quest_desc: [
		"If you're like me, or any sane person you despise Powdered Snow. Thankfully &l&3Artifacts&r gives us a tool for dealing with it! Snowshoes! \\n\\nSnowshoes will allow you to safely walk over Powdered Snow just like how Leather Boots do. You will also get a Speed boost when walking on any Snow!"
	]
	quest.74B352457BF1541B.quest_subtitle: "Feet"
	quest.7503823ACDDB0491.quest_desc: [
		"This and the &aSuperstitious Hat&r gives you all the lucky charms you can need!\\nThe &2Lucky Scarf&r gives you an extra level of Fortune to your Pickaxes."
	]
	quest.7503823ACDDB0491.quest_subtitle: "Scarf (Necklace)"
	quest.7503823ACDDB0491.title: "&2Lucky Scarf&r"
	quest.789AF6D0A6321945.quest_desc: [
		"The single most important! Most powerful! Most dangerous &l&3Artifact&r of them all!"
		"{@pagebreak}"
		"I'm not even sure if I should explain what it does, it's too dangerous!"
		"{@pagebreak}"
		"If you're so sure you can handle its power, then maybe keep reading..."
		"{@pagebreak}"
		"Not too late to turn back!"
		"{@pagebreak}"
		"Okay I warned you..."
		"{@pagebreak}"
		"Press Shift for a chance to Fart when &dWhoopie Cushion&r is equipped."
	]
	quest.789AF6D0A6321945.quest_subtitle: "Unique"
	quest.789AF6D0A6321945.title: "&dWhoopie Cushion&r"
	task.376652638B9221C9.title: "AllRightsReserved"
	task.68DC39876E14FC1B.title: "Kill 1 Mimic"
	task.72E89066290E3040.title: "AllRightsReserved"
	chapter.0CC65817272B53A4.title: "Dungeons & Adventures"
	quest.2120FC8CCEE55FE9.title: "Adventure Map"
	quest.2120FC8CCEE55FE9.quest_subtitle: "Start"
	quest.2120FC8CCEE55FE9.quest_desc: [
		"The world now has many structures: dungeons, towers, taverns, fortresses and ships."

		"{@pagebreak}"

		"Craft a &bNature's Compass&r to search for biomes."

		"If commands are allowed, you can find a structure with &e/locate structure <id>&r."

		"{@pagebreak}"

		"Each quest leads to a new structure. Bring food, torches and good armor - many places are dangerous."
	]
	quest.99363C9930CF43AC.title: "Skeleton Dungeon"
	quest.99363C9930CF43AC.quest_subtitle: "Yung's Better Dungeons"
	quest.99363C9930CF43AC.quest_desc: [
		"Find and enter a dungeon full of skeletons. Chests and spawners inside - bring a weapon and a shield."
	]
	quest.6889C91E3005A706.title: "Zombie Dungeon"
	quest.6889C91E3005A706.quest_subtitle: "Yung's Better Dungeons"
	quest.6889C91E3005A706.quest_desc: [
		"Zombies come in crowds. Enter carefully through one corridor at a time."
	]
	quest.3A31AADC19E3ECBF.title: "Spider Dungeon"
	quest.3A31AADC19E3ECBF.quest_subtitle: "Yung's Better Dungeons"
	quest.3A31AADC19E3ECBF.quest_desc: [
		"Webs and cave spiders: bring shears or a sword and milk to cure poison."
	]
	quest.071674EE0693E0D9.title: "Witch Hut"
	quest.071674EE0693E0D9.quest_subtitle: "Yung's Better Witch Huts"
	quest.071674EE0693E0D9.quest_desc: [
		"A witch hut in the swamp. Watch out for potions."
	]
	quest.6BE1E08A7E114E68.title: "Tavern"
	quest.6BE1E08A7E114E68.quest_subtitle: "Dungeons and Taverns"
	quest.6BE1E08A7E114E68.quest_desc: [
		"Visit a wooden tavern. Supplies and a place to sleep inside."
	]
	quest.8DE424016B820FE4.title: "Undead Crypt"
	quest.8DE424016B820FE4.quest_subtitle: "Dungeons and Taverns"
	quest.8DE424016B820FE4.quest_desc: [
		"An underground crypt full of undead. Bring light and a good weapon."
	]
	quest.0A727244D2A65227.title: "Creeping Crypt"
	quest.0A727244D2A65227.quest_subtitle: "Dungeons and Taverns"
	quest.0A727244D2A65227.quest_desc: [
		"A grim crypt full of creepers. Do not let them into narrow corridors."
	]
	quest.141337ACF1E2B441.title: "Illager Manor"
	quest.141337ACF1E2B441.quest_subtitle: "Dungeons and Taverns"
	quest.141337ACF1E2B441.quest_desc: [
		"An illager manor with guards."
	]
	quest.6EDE80A3BA89E31D.title: "Illager Fort"
	quest.6EDE80A3BA89E31D.quest_subtitle: "When Dungeons Arise"
	quest.6EDE80A3BA89E31D.quest_desc: [
		"A large illager stronghold. Bring friends."
	]
	quest.C6C4EE2E3B9EFAD5.title: "Bandit Towers"
	quest.C6C4EE2E3B9EFAD5.quest_subtitle: "When Dungeons Arise"
	quest.C6C4EE2E3B9EFAD5.quest_desc: [
		"Bandit towers with archers and traps."
	]
	quest.BE6FA6127EA696C3.title: "Plague Asylum"
	quest.BE6FA6127EA696C3.quest_subtitle: "When Dungeons Arise"
	quest.BE6FA6127EA696C3.quest_desc: [
		"A plague-ridden asylum. Bring potions and sturdy armor."
	]
	quest.E25C7C4AE65CB5DB.title: "Infested Temple"
	quest.E25C7C4AE65CB5DB.quest_subtitle: "When Dungeons Arise"
	quest.E25C7C4AE65CB5DB.quest_desc: [
		"A temple crawling with silverfish. Look for the entrance among the stones."
	]
	quest.3500F48AB489CB10.title: "Keep Kayra"
	quest.3500F48AB489CB10.quest_subtitle: "When Dungeons Arise"
	quest.3500F48AB489CB10.quest_desc: [
		"One of the largest structures of the mod. Bring food and potions."
	]
	quest.62734460417AE7FB.title: "Mining Complex"
	quest.62734460417AE7FB.quest_subtitle: "When Dungeons Arise"
	quest.62734460417AE7FB.quest_desc: [
		"A big mine with vaults and special enchantments."
	]
	quest.2C442A3AD00F1436.title: "Mechanical Nest"
	quest.2C442A3AD00F1436.quest_subtitle: "When Dungeons Arise"
	quest.2C442A3AD00F1436.quest_desc: [
		"A mechanical lair leading into the mines below."
	]
	quest.7C3C2F9F335B53E5.title: "Desert Temple"
	quest.7C3C2F9F335B53E5.quest_subtitle: "Yung's Better Desert Temples"
	quest.7C3C2F9F335B53E5.quest_desc: [
		"Traps and secret rooms under the sand."
	]
	quest.53976270C78E175D.title: "Jungle Temple"
	quest.53976270C78E175D.quest_subtitle: "Yung's Better Jungle Temples"
	quest.53976270C78E175D.quest_desc: [
		"A jungle temple: traps, levers and treasure."
	]
	quest.213B6DA5685F71AE.title: "Ocean Monument"
	quest.213B6DA5685F71AE.quest_subtitle: "Yung's Better Ocean Monuments"
	quest.213B6DA5685F71AE.quest_desc: [
		"An underwater fortress with guardians. Bring water breathing."
	]
	quest.5E4C955942756822.title: "Stronghold"
	quest.5E4C955942756822.quest_subtitle: "Yung's Better Strongholds"
	quest.5E4C955942756822.quest_desc: [
		"Find the underground stronghold. It leads to the End."
	]
	quest.F428D119E3DFF133.title: "Nether Fortress"
	quest.F428D119E3DFF133.quest_subtitle: "Yung's Better Nether Fortresses"
	quest.F428D119E3DFF133.quest_desc: [
		"A fortress in the Nether."
	]
	quest.1674844A519AABEC.title: "Piglin Donjon"
	quest.1674844A519AABEC.quest_subtitle: "Dungeons and Taverns"
	quest.1674844A519AABEC.quest_desc: [
		"A piglin stronghold. Wear gold and keep fire resistance handy."
	]
	quest.D64A860802F38533.title: "End Castle"
	quest.D64A860802F38533.quest_subtitle: "Dungeons and Taverns"
	quest.D64A860802F38533.quest_desc: [
		"A castle on the outer End islands."
	]
	quest.1E0E94DACDCA2A59.title: "Dungeon Master"
	quest.1E0E94DACDCA2A59.quest_subtitle: "Finale"
	quest.1E0E94DACDCA2A59.quest_desc: [
		"You completed the main dungeons of the world. Take your reward and move on: Cataclysm, Twilight Forest and Deeper Darker await."
	]
	task.3056DFADA05552BE.title: "Find: Skeleton Dungeon"
	task.C0450C5C86166DEC.title: "Find: Zombie Dungeon"
	task.95E30255B5D45D27.title: "Find: Spider Dungeon"
	task.B49F8D70989DA94A.title: "Find: Witch Hut"
	task.C02AEDEBA2F6AA9E.title: "Find: Tavern"
	task.A087CC556F4BE6E8.title: "Find: Undead Crypt"
	task.3E60CA3809906D54.title: "Find: Creeping Crypt"
	task.564B1DD7CDEE32A2.title: "Find: Illager Manor"
	task.0F276F7FD5562BFA.title: "Find: Illager Fort"
	task.3892543B0FDF7BC0.title: "Find: Bandit Towers"
	task.8B1E1BC8CD7CBF52.title: "Find: Plague Asylum"
	task.3060D10A946FE4FF.title: "Find: Infested Temple"
	task.3985F9E7AC6C785B.title: "Find: Keep Kayra"
	task.15A7DB7DF35032D8.title: "Find: Mining Complex"
	task.88784399D488568F.title: "Find: Mechanical Nest"
	task.FB6C68D5B547B182.title: "Find: Desert Temple"
	task.6681D9241DD87B27.title: "Find: Jungle Temple"
	task.87EC348182DAD535.title: "Find: Ocean Monument"
	task.1DCB523513030A49.title: "Find: Stronghold"
	task.794EA4975B9652EF.title: "Find: Nether Fortress"
	task.AE554A5B0F1521D0.title: "Find: Piglin Donjon"
	task.813555B112B0FE9C.title: "Find: End Castle"
	quest.99363C9930CF43AC.title: "Эффективность"
	quest.99363C9930CF43AC.quest_desc: [
		"Модуль эффективности ускоряет работу лазера. Чем выше уровень модуля, тем быстрее идёт добыча."
	]
	quest.BE6FA6127EA696C3.title: "Дальность"
	quest.BE6FA6127EA696C3.quest_desc: [
		"Модуль дальности увеличивает расстояние, с которого лазер добывает блоки."
	]
	quest.D64A860802F38533.title: "Площадь 5×5"
	quest.D64A860802F38533.quest_desc: [
		"Расширенный модуль позволяет добывать сразу область 5×5 блоков."
	]
	quest.9063204D4E6752C1.title: "Заморозка"
	quest.9063204D4E6752C1.quest_desc: [
		"Модуль заморозки для шахтёрского лазера. Устанавливается в столе модификаций."
	]
	quest.95E30255B5D45D27.title: "Ёмкая батарея"
	quest.95E30255B5D45D27.quest_desc: [
		"Батарея второго уровня увеличивает запас энергии гаджета, чтобы его хватало на более долгую работу."
	]
	quest.A52DD713B80A40B6.title: "Шахтёрский фонарь"
	quest.A52DD713B80A40B6.quest_desc: [
		"Источник света для подземных работ: пригодится в длинных тоннелях."
	]
	quest.C83E8BAF538499D9.title: "Подзорная труба"
	quest.C83E8BAF538499D9.quest_desc: [
		"Позволяет рассмотреть далёкие постройки и не пропустить интересные места на пути."
	]
	quest.E02071366047B633.title: "Компас возвращения"
	quest.E02071366047B633.quest_desc: [
		"Указывает на место вашей последней смерти. Поможет вернуть потерянные вещи."
	]
	quest.9CB9557B327BD25B.title: "Эндер-сундук"
	quest.9CB9557B327BD25B.quest_desc: [
		"Все ваши эндер-сундуки открывают одно и то же хранилище, поэтому вещи всегда под рукой."
	]
	quest.8B1E1BC8CD7CBF52.title: "Варп-плита"
	quest.8B1E1BC8CD7CBF52.quest_desc: [
		"Плиты быстрого перемещения помогают быстро добираться между важными точками базы."
	]
	quest.AFA98C2177F38F49.title: "Элитры"
	quest.AFA98C2177F38F49.quest_desc: [
		"Крылья для планирования. Их можно найти в кораблях городов Края; вместе с фейерверками они ускоряют любые путешествия."
	]
	quest.88784399D488568F.title: "Корзина"
	quest.88784399D488568F.quest_desc: [
		"Удобная корзина для хранения продуктов на кухне."
	]
	quest.A704BAAD5793637E.title: "Рис"
	quest.A704BAAD5793637E.quest_desc: [
		"Рис растёт на мелководье и входит во многие рецепты."
	]
	quest.85F6E63FE2CDE537.title: "Яблочный пирог"
	quest.85F6E63FE2CDE537.quest_desc: [
		"Сытный десерт из яблок."
	]
	quest.AE554A5B0F1521D0.title: "Ягодный чизкейк"
	quest.AE554A5B0F1521D0.quest_desc: [
		"Десерт из сладких ягод."
	]
	quest.C8B8DEB8872CB62D.title: "Чайный лист"
	quest.C8B8DEB8872CB62D.quest_desc: [
		"Листья нужны для приготовления чая в чайнике."
	]
	quest.4A0DDDF4BE034AEB.title: "Торт"
	quest.4A0DDDF4BE034AEB.quest_desc: [
		"Классический торт: хороший повод отметить успехи на базе."
	]
	quest.FE4FF0AAA8BF84AF.title: "Набор пластин"
	quest.FE4FF0AAA8BF84AF.quest_desc: [
		"Набор деталей для сборки пластин брони."
	]
	quest.30EC2DDCB7454771.title: "Набор снаряжения"
	quest.30EC2DDCB7454771.quest_desc: [
		"Заготовка для сборки снаряжения Protection Pixel."
	]
	quest.E98E0686826035DF.title: "Жаропрочная керамика"
	quest.E98E0686826035DF.quest_desc: [
		"Лист жаропрочной керамики: нужен для деталей, которые должны выдерживать нагрев."
	]
	quest.AC2A9F6A86E026A2.title: "Аванпост разбойников"
	quest.AC2A9F6A86E026A2.quest_desc: [
		"Найдите аванпост разбойников. Осторожно: рядом может быть засада и патрули."
	]
	task.296336056B805353.title: "Найдите: Аванпост разбойников"
	quest.0296F3CEDC6B3596.title: "Заброшенная шахта"
	quest.0296F3CEDC6B3596.quest_desc: [
		"Отыщите заброшенную шахту. Возьмите факелы и оружие."
	]
	task.D329BF8E3514327C.title: "Найдите: Заброшенная шахта"
	quest.15B62E285EBBAE3B.title: "Лесной особняк"
	quest.15B62E285EBBAE3B.quest_desc: [
		"Особняк иллагеров в тёмном лесу: опасное и богатое место."
	]
	task.69B00AA82D06EF13.title: "Найдите: Лесной особняк"
	quest.EA8B7D658505DBAA.title: "Камеры испытаний"
	quest.EA8B7D658505DBAA.quest_desc: [
		"Подземный комплекс испытаний с генераторами мобов и наградами."
	]
	task.0019981F9638FB35.title: "Найдите: Камеры испытаний"
	quest.9F6A6FBE1C3E135B.title: "Бастион"
	quest.9F6A6FBE1C3E135B.quest_desc: [
		"Руины бастиона в Нижнем мире: пиглины и ценная добыча."
	]
	task.AC1B7B7BA596CBBE.title: "Найдите: Бастион"
	quest.1A7763B665C40BA3.title: "Древний город"
	quest.1A7763B665C40BA3.quest_desc: [
		"Глубокий тёмный город с хранителем. Двигайтесь тихо."
	]
	task.F0CFBD4802CC98C3.title: "Найдите: Древний город"
	quest.8510E7E7D2C5D1C2.title: "Крыло"
	quest.8510E7E7D2C5D1C2.quest_desc: [
		"Крылья добавляют подъёмную силу воздушным конструкциям."
	]
	quest.75C78C9AA7F3BDCD.title: "Двигатель Стирлинга"
	quest.75C78C9AA7F3BDCD.quest_desc: [
		"Тепловой двигатель, который превращает тепло горелки в энергию."
	]
	quest.489A1273424BFDBA.title: "Жидкостная горелка"
	quest.489A1273424BFDBA.quest_desc: [
		"Горелка на жидком топливе для питания двигателей."
	]
	quest.2D3BA8CF7C1F0D33.title: "Автосборка"
	quest.2D3BA8CF7C1F0D33.quest_desc: [
		"Инструмент: правый щелчок по блоку собирает связанную конструкцию, а по готовой разбирает её."
	]
	quest.2459826D28C3161C.title: "Автоклей"
	quest.2459826D28C3161C.quest_desc: [
		"Одним щелчком создаёт медовый клей над всей связанной конструкцией."
	]
	quest.E4EE4F0217F795D9.title: "Конденсатор"
	quest.E4EE4F0217F795D9.quest_desc: [
		"Накопитель для электрической части Create Crafts & Additions."
	]
	quest.4EDAEDE6BDB8F021.title: "Цифровой адаптер"
	quest.4EDAEDE6BDB8F021.quest_desc: [
		"Цифровой адаптер из Create Crafts & Additions."
	]
	quest.51263872B1B703AF.title: "Латунная коробка передач"
	quest.51263872B1B703AF.quest_desc: [
		"Улучшенная коробка передач из Create: Connected."
	]
	quest.16A41E0E45FC52B2.title: "Катализатор заморозки"
	quest.16A41E0E45FC52B2.quest_desc: [
		"Катализатор для вентилятора: замораживает предметы, проходящие через поток."
	]
	quest.CC89F3AA6BE9E24D.title: "Атлас жил"
	quest.CC89F3AA6BE9E24D.quest_desc: [
		"Помогает искать жилы руды для бурильной установки."
	]
	quest.3249B1E0C9F7DA08.title: "Разбрызгиватель"
	quest.3249B1E0C9F7DA08.quest_desc: [
		"Автоматически поливает посевы и помогает фермам Create."
	]
	quest.73401C8819CA5E32.title: "Большое флюкс-хранилище"
	quest.73401C8819CA5E32.quest_desc: [
		"Хранилище следующего уровня для флюкс-сети."
	]
	quest.E55ADCCA752B2FE6.title: "Флюкс-конфигуратор"
	quest.E55ADCCA752B2FE6.quest_desc: [
		"Инструмент для настройки устройств Flux Networks."
	]
	quest.1D13CD81BD0CBCB8.title: "Улучшенный модуль Pipez"
	quest.1D13CD81BD0CBCB8.quest_desc: [
		"Ускоряет и усиливает передачу по трубам Pipez."
	]
	quest.7EA4DA4B169E56FA.title: "Ветрогенератор"
	quest.7EA4DA4B169E56FA.quest_desc: [
		"Вырабатывает энергию ветром: чем выше, тем лучше."
	]
	quest.2C3D9BEB2C74CB94.title: "Биогенератор"
	quest.2C3D9BEB2C74CB94.quest_desc: [
		"Сжигает биотопливо и вырабатывает энергию."
	]
	quest.8CBC0F29CE433885.title: "Как устроены главы"
	quest.8CBC0F29CE433885.quest_desc: [
		"Слева список глав. «Гайд: путь развития» — основная линия сборки, остальные группы — дополнительные темы."
	]
	quest.3A5DEC37E6F263CC.title: "Награды"
	quest.3A5DEC37E6F263CC.quest_desc: [
		"Выполненный квест даёт награду. Нажмите на неё, чтобы забрать."
	]
	quest.593388F68612A82B.title: "Рецепты в JEI"
	quest.593388F68612A82B.quest_desc: [
		"Наведите курсор на предмет и нажмите R, чтобы увидеть рецепт, или U, чтобы увидеть, где он применяется."
	]
	chapter.63F17F68335641EC.title: "&6Create: Diesel Engines"
	chapter.63F17F68335641EC.chapter_subtitle: [
		"Oil, biofuel and engines for aircraft"
	]
	quest.C7A46F74EF9513C3.title: "&6&lThe Diesel Age"
	quest.C7A46F74EF9513C3.quest_subtitle: "Craft an engine piston"
	quest.C7A46F74EF9513C3.quest_desc: [
		"&6Create: Diesel Generators&r adds &ecombustion engines&r that spin Create shafts on liquid fuel."
		""
		"It all starts with an &6engine piston&r. Check JEI (R) and Ponder (hold &eW&r)."
	]
	quest.34D1BCED791147D7.title: "Diesel Engine"
	quest.34D1BCED791147D7.quest_subtitle: "Your first motor"
	quest.34D1BCED791147D7.quest_desc: [
		"The &6Diesel Engine&r produces rotation as long as fuel is piped in."
		""
		"Any fuel from this chapter works: &eplant oil&r, &eethanol&r, &ebiodiesel&r, &egasoline&r, &ediesel&r. Better fuel = more speed and stress capacity (check with goggles)."
	]
	quest.BBC59EB105B18324.title: "Modular Engine"
	quest.BBC59EB105B18324.quest_subtitle: "Chain them up"
	quest.BBC59EB105B18324.quest_desc: [
		"The &6Modular Diesel Engine&r stacks along a shaft — each block adds more power."
		""
		"Great for factories that outgrew water wheels and steam engines."
	]
	quest.840EFC8894FFBFDE.title: "Huge Engine"
	quest.840EFC8894FFBFDE.quest_subtitle: "Steam-engine scale power"
	quest.840EFC8894FFBFDE.quest_desc: [
		"The &6Huge Diesel Engine&r works like a diesel steam engine: build it around a shaft with &epowered engine shafts&r."
		""
		"The strongest rotation source in the mod."
	]
	quest.9A5EC31676CB01B8.title: "Turbocharger"
	quest.9A5EC31676CB01B8.quest_subtitle: "More RPM"
	quest.9A5EC31676CB01B8.quest_desc: [
		"Right-click an engine with a &6Turbocharger&r to boost its output."
	]
	quest.BD0D38CCE2B759E7.title: "Silencer"
	quest.BD0D38CCE2B759E7.quest_subtitle: "Keep it down"
	quest.BD0D38CCE2B759E7.quest_desc: [
		"The &6Silencer&r mutes the engine noise. Your neighbours will thank you."
	]
	quest.5676E19C94E6C7F3.title: "Plant Oil"
	quest.5676E19C94E6C7F3.quest_subtitle: "The simplest fuel"
	quest.5676E19C94E6C7F3.quest_desc: [
		"Compact &eseeds&r in a &6basin&r with a mechanical press to get &6plant oil&r."
		""
		"Weak, but the easiest fuel to start with."
	]
	quest.1D990690AFAB4887.title: "Bulk Fermenter"
	quest.1D990690AFAB4887.quest_subtitle: "Brewery"
	quest.1D990690AFAB4887.quest_desc: [
		"The &6Bulk Fermenter&r is multiblock like a tank. Feed it &efermentables&r (sugar, potatoes, berries…) plus &ebone meal&r to make &6ethanol&r."
	]
	quest.1225A37C136585C8.title: "Ethanol"
	quest.1225A37C136585C8.quest_subtitle: "Engine spirits"
	quest.1225A37C136585C8.quest_desc: [
		"&6Ethanol&r is a mid-tier fuel and a biodiesel ingredient."
	]
	quest.3440F2F684A1C754.title: "Biodiesel"
	quest.3440F2F684A1C754.quest_subtitle: "Green fuel"
	quest.3440F2F684A1C754.quest_desc: [
		"Mix &6plant oil&r and &6ethanol&r (100 mB each) in a basin with a &emechanical mixer&r to get 200 mB of &6biodiesel&r."
		""
		"Good fuel without any oil: farms are enough!"
	]
	quest.D345185F64CB43EB.title: "Oil Scanner"
	quest.D345185F64CB43EB.quest_subtitle: "Where to drill?"
	quest.D345185F64CB43EB.quest_desc: [
		"The &6Oil Scanner&r shows how much oil lies under the current chunk."
		""
		"Some biomes have more oil than others. Find a rich chunk."
	]
	quest.5C4E0C692CB937CD.title: "Pumpjack"
	quest.5C4E0C692CB937CD.quest_subtitle: "Oil rig"
	quest.5C4E0C692CB937CD.quest_desc: [
		"The &6Pumpjack&r pumps oil from the chunk: the &ehole&r goes on the ground, the &ehead&r on the arm above it, the &ebearing&r in the middle and the &ecrank&r driven by a shaft."
		""
		"Follow the Ponder scene (W) for exact placement."
	]
	quest.8849872FB46CE97C.title: "Crude Oil"
	quest.8849872FB46CE97C.quest_subtitle: "Black gold"
	quest.8849872FB46CE97C.quest_desc: [
		"&6Crude oil&r burns poorly — it has to be distilled."
	]
	quest.6BC38D74959AFB4A.title: "Distillation Tower"
	quest.6BC38D74959AFB4A.quest_subtitle: "Refining"
	quest.6BC38D74959AFB4A.quest_desc: [
		"Stack &eCreate fluid tanks&r and attach &6distillation controllers&r to form a &6distillation tower&r."
		""
		"It needs a &eheated blaze burner&r below. Each level outputs its own fraction."
	]
	quest.CFB7360B87874FA3.title: "&eDiesel & Gasoline"
	quest.CFB7360B87874FA3.quest_subtitle: "Top-tier fuel"
	quest.CFB7360B87874FA3.quest_desc: [
		"Distillation yields &6diesel&r and &6gasoline&r — the strongest fuel for engines and aircraft."
		""
		"Store it in tanks or &eoil barrels&r, carry it in &ecanisters&r."
	]
	quest.7C06B18432AB8CCB.title: "Canister"
	quest.7C06B18432AB8CCB.quest_subtitle: "Fuel to go"
	quest.7C06B18432AB8CCB.quest_desc: [
		"The &6Canister&r holds fluid and can refuel engines on the go."
	]
	quest.57ECDABDA6C2B6FE.title: "&bPortable Engine"
	quest.57ECDABDA6C2B6FE.quest_subtitle: "A motor for aircraft"
	quest.57ECDABDA6C2B6FE.quest_desc: [
		"The &bPortable Engine&r from Create Aeronautics spins propellers right on a physics contraption."
		""
		"With the &bAeronautical Diesel&r addon it also runs on &6liquid fuels&r from this chapter."
		""
